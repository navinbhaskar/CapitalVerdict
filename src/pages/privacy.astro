---
import ProsePage from '@/layouts/ProsePage.astro';
import { site } from '@/config/site';
---

<ProsePage
  locale="en"
  page="privacy"
  sections={[
    { key: 'device' },
    { key: 'cookies' },
    { key: 'links' },
    { key: 'analytics', bodyKey: site.analyticsToken ? 'analytics.bodyOn' : undefined },
    { key: 'thirdParty', bodyKey: site.analyticsToken ? 'thirdParty.bodyOn' : undefined },
  ]}
/>
