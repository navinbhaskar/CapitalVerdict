---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import { t } from '@/i18n/t';

const locale = 'en';
const tools = [
  { href: '/tools/car-fuel/', label: t(locale, 'tool.carFuel.title') },
  { href: '/tools/solar/', label: t(locale, 'tool.solar.title') },
  { href: '/tools/rent-vs-buy/', label: t(locale, 'tool.rentVsBuy.title') },
  { href: '/tools/prepay-or-invest/', label: t(locale, 'tool.prepay.title') },
  { href: '/tools/emi-calculator/', label: t(locale, 'tool.emi.title') },
  { href: '/tools/which-debt-first/', label: t(locale, 'tool.debtOrder.title') },
  { href: '/tools/cash-or-car-loan/', label: t(locale, 'tool.carLoan.title') },
  { href: '/tools/ac-payback/', label: t(locale, 'tool.ac.title') },
  { href: '/tools/old-or-new-tax-regime/', label: t(locale, 'tool.taxRegime.title') },
  { href: '/tools/plot-vs-fd-vs-mutual-fund/', label: t(locale, 'tool.plotVs.title') },
  { href: '/tools/sip-vs-ppf-vs-fd/', label: t(locale, 'tool.saving.title') },
  { href: '/tools/sip-calculator/', label: t(locale, 'tool.sip.title') },
  { href: '/tools/lumpsum-calculator/', label: t(locale, 'tool.lumpsum.title') },
  { href: '/tools/swp-calculator/', label: t(locale, 'tool.swp.title') },
  { href: '/tools/plan-return/', label: t(locale, 'tool.planReturn.title') },
  { href: '/tools/term-plus-investing/', label: t(locale, 'tool.termPlan.title') },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, 'page.notFound.title')}
  description={t(locale, 'page.notFound.description')}
  noindex
>
  <PageIntro title={t(locale, 'page.notFound.title')} lead={t(locale, 'page.notFound.body')} />
  <div class="container-page pt-6 pb-12">
    <ul class="mt-5 grid max-w-3xl gap-3 sm:grid-cols-3" role="list">
      {tools.map((tool) => (
        <li>
          <a
            href={tool.href}
            class="flex min-h-11 items-center rounded-lg border border-line px-4 py-3 font-medium transition-colors duration-(--duration-fast) ease-out-quart hover:border-line-strong hover:bg-surface"
          >
            {tool.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6">
      <a href="/" class="link">
        {t(locale, 'page.notFound.home')}
      </a>
    </p>
  </div>
</BaseLayout>
