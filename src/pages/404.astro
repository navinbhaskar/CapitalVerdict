---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import { t } from '@/i18n/t';

const locale = 'en';
const tools = [
  { href: '/tools/car-fuel/', label: t(locale, 'tool.carFuel.title') },
  { href: '/tools/solar/', label: t(locale, 'tool.solar.title') },
  { href: '/tools/rent-vs-buy/', label: t(locale, 'tool.rentVsBuy.title') },
];
---

<BaseLayout
  locale={locale}
  title={t(locale, 'page.notFound.title')}
  description={t(locale, 'page.notFound.description')}
  noindex
>
  <PageIntro title={t(locale, 'page.notFound.title')} lead={t(locale, 'page.notFound.body')} />
  <div class="container-page pt-8 pb-16">
    <ul class="mt-5 grid max-w-3xl gap-3 sm:grid-cols-3" role="list">
      {tools.map((tool) => (
        <li>
          <a
            href={tool.href}
            class="flex min-h-11 items-center rounded-lg border border-line px-4 py-3 font-medium transition-colors duration-(--duration-fast) ease-out-quart hover:border-line-strong hover:bg-surface"
          >
            {tool.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6">
      <a href="/" class="link">
        {t(locale, 'page.notFound.home')}
      </a>
    </p>
  </div>
</BaseLayout>
