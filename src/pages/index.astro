---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t, type MessageKey } from '@/i18n/t';

const locale = 'en';

const tools: { title: MessageKey; question: MessageKey }[] = [
  { title: 'tool.carFuel.title', question: 'tool.carFuel.question' },
  { title: 'tool.rentVsBuy.title', question: 'tool.rentVsBuy.question' },
  { title: 'tool.solar.title', question: 'tool.solar.question' },
];

const principles: { title: MessageKey; body: MessageKey }[] = [
  { title: 'principle.assumptions.title', body: 'principle.assumptions.body' },
  { title: 'principle.conservative.title', body: 'principle.conservative.body' },
  { title: 'principle.realTerms.title', body: 'principle.realTerms.body' },
  { title: 'principle.noProducts.title', body: 'principle.noProducts.body' },
];
---

<BaseLayout locale={locale}>
  <section class="container-page grid items-center gap-12 pt-16 pb-20 sm:pt-24 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <h1 class="max-w-2xl text-[2.25rem] leading-[1.1] font-semibold sm:text-5xl">
        {t(locale, 'site.tagline')}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-muted">{t(locale, 'home.intro')}</p>
      <a
        href="#tools"
        class="mt-10 inline-flex min-h-12 items-center gap-2 rounded-lg bg-ink px-6 font-medium text-white transition-colors duration-200 hover:bg-ink-hover"
      >
        {t(locale, 'home.cta')}
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path
            d="M5 12h14m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
    </div>

    <!-- Brand motif: two cost lines crossing at the break-even point. Decorative only. -->
    <svg
      class="hidden w-full max-w-sm justify-self-end text-ink lg:block"
      viewBox="0 0 320 240"
      aria-hidden="true"
      fill="none"
    >
      <g stroke="var(--color-line)" stroke-width="1">
        <line x1="20" y1="40" x2="300" y2="40"></line>
        <line x1="20" y1="100" x2="300" y2="100"></line>
        <line x1="20" y1="160" x2="300" y2="160"></line>
        <line x1="20" y1="220" x2="300" y2="220"></line>
      </g>
      <path
        d="M20 120 L300 172"
        stroke="currentColor"
        stroke-opacity="0.3"
        stroke-width="2.5"
        stroke-linecap="round"
      ></path>
      <path
        d="M20 200 L300 52"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
      ></path>
      <line
        x1="132"
        y1="141"
        x2="132"
        y2="220"
        stroke="var(--color-accent)"
        stroke-width="1.5"
        stroke-dasharray="3 4"
      ></line>
      <circle cx="132" cy="141" r="7" fill="var(--color-accent)"></circle>
      <circle cx="132" cy="141" r="14" fill="var(--color-accent)" fill-opacity="0.12"></circle>
    </svg>
  </section>

  <section id="tools" class="scroll-mt-20 border-t border-line bg-surface">
    <div class="container-page py-16 sm:py-20">
      <h2 class="text-sm font-medium tracking-[0.08em] text-ink-muted uppercase">
        {t(locale, 'home.tools.heading')}
      </h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {tools.map((tool, i) => (
          <li>
            <article class="flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-page p-6 transition-colors duration-200 hover:border-line-strong">
              <div class="flex items-center justify-between">
                <span class="num text-sm text-ink-subtle" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-strong">
                  {t(locale, 'home.tools.status.soon')}
                </span>
              </div>
              <h3 class="mt-8 text-xl font-semibold">{t(locale, tool.title)}</h3>
              <p class="mt-2 text-ink-muted">{t(locale, tool.question)}</p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="principles" class="container-page scroll-mt-20 py-16 sm:py-20">
    <h2 class="text-sm font-medium tracking-[0.08em] text-ink-muted uppercase">
      {t(locale, 'home.principles.heading')}
    </h2>
    <ul class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {principles.map((p) => (
        <li class="border-t-2 border-ink pt-5">
          <h3 class="font-semibold">{t(locale, p.title)}</h3>
          <p class="mt-2 text-[0.9375rem] text-ink-muted">{t(locale, p.body)}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
