---
import ToolLayout from '@/layouts/ToolLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import AssumptionsTable, { type AssumptionRow } from '@/components/tool/AssumptionsTable.astro';
import HraTool from '@/components/islands/HraTool';
import { t, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { incomeTax } from '@/data';
import { formatPercent } from '@/lib/formatTool';

const locale = 'en';
const h = incomeTax.hra;
const rows: AssumptionRow[] = [
  {
    label: t(locale, 'tool.hra.title'),
    value: `${formatPercent(h.largeCityShare)} / ${formatPercent(h.otherShare)}`,
    source: h.source,
    date: h.effectiveDate,
    verified: h.status === 'verified',
  },
  {
    label: t(locale, 'hra.in.slabRate'),
    value: incomeTax.regimes.old.slabs.map((s) => formatPercent(s.rate)).join(' / '),
    source: incomeTax.source,
    date: incomeTax.effectiveDate,
    verified: incomeTax.status === 'verified',
  },
];

const FAQ = [1, 2, 3] as const;
const related = [
  {
    href: localizePath('/tools/old-or-new-tax-regime/', locale),
    label: t(locale, 'tool.taxRegime.title'),
  },
  { href: localizePath('/tools/rent-vs-buy/', locale), label: t(locale, 'tool.rentVsBuy.title') },
  { href: localizePath('/tools/sip-vs-ppf-vs-fd/', locale), label: t(locale, 'tool.saving.title') },
];
---

<ToolLayout
  locale={locale}
  title={t(locale, 'tool.hra.question')}
  description={t(locale, 'hra.metaDescription')}
  related={related}
  faq={FAQ.map((n) => ({
    q: t(locale, `hra.faq.${n}.q` as MessageKey),
    a: t(locale, `hra.faq.${n}.a` as MessageKey),
  }))}
>
  <HraTool client:load locale={locale} />

  <p slot="explanation">{t(locale, 'hra.explanation')}</p>

  <AssumptionsTable slot="assumptions" locale={locale} rows={rows} />

  <div slot="faq" class="divide-y divide-line border-y border-line">
    {FAQ.map((n) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2.5 font-medium text-ink">
          {t(locale, `hra.faq.${n}.q` as MessageKey)}
          <Icon
            name="chevronDown"
            size={18}
            class="shrink-0 text-ink-muted transition-transform duration-(--duration-base) ease-out-quart group-open:rotate-180"
          />
        </summary>
        <p class="max-w-(--container-prose) pb-3 text-sm">
          {t(locale, `hra.faq.${n}.a` as MessageKey)}
        </p>
      </details>
    ))}
  </div>
</ToolLayout>
