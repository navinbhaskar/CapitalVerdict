---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import { t } from '@/i18n/t';
import { byDateDesc, readingMinutes } from '@/lib/blog';

const locale = 'en';
const posts = (await getCollection('blog')).sort(byDateDesc);
const kinds = [
  { kind: 'decision', heading: t(locale, 'blog.kind.decision') },
  { kind: 'basics', heading: t(locale, 'blog.kind.basics') },
  { kind: 'update', heading: t(locale, 'blog.kind.update') },
] as const;
const dateFormat = new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeZone: 'UTC' });
---

<BaseLayout
  locale={locale}
  title={t(locale, 'blog.title')}
  description={t(locale, 'blog.description')}
>
  <PageIntro title={t(locale, 'blog.title')} lead={t(locale, 'blog.intro')}>
    <p class="mt-4 text-sm">
      <a href="/guides/rss.xml" class="link">
        {t(locale, 'blog.rss')}
      </a>
    </p>
  </PageIntro>
  <div class="container-page pt-2 pb-10 sm:pb-12">
    {kinds.map(({ kind, heading }) => {
      const list = posts.filter((p) => p.data.kind === kind);
      return (
        list.length > 0 && (
          <section class="mt-6 max-w-3xl" aria-labelledby={`k-${kind}`}>
            <h2 id={`k-${kind}`} class="font-display text-2xl font-medium">
              {heading}
            </h2>
            <ul class="mt-3 divide-y divide-line border-y border-line" role="list">
              {list.map((post) => (
                <li>
                  <a
                    href={`/guides/${post.id}/`}
                    class="group block py-4 transition-colors duration-(--duration-fast) ease-out-quart"
                  >
                    <span class="block font-medium text-ink group-hover:text-accent-strong">
                      {post.data.title}
                    </span>
                    <span class="mt-1 block text-sm text-ink-muted">{post.data.description}</span>
                    <span class="num mt-1.5 block text-sm text-ink-muted">
                      <time datetime={post.data.date.toISOString().slice(0, 10)}>
                        {dateFormat.format(post.data.date)}
                      </time>
                      {', '}
                      {t(locale, 'blog.minutes', { n: readingMinutes(post.body ?? '') })}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })}
  </div>
</BaseLayout>
