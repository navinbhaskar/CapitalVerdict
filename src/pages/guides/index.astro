---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import GuideCard from '@/components/blog/GuideCard.astro';
import { t } from '@/i18n/t';
import { areaId, byDateDesc, guideArea } from '@/lib/blog';
import { TOOL_GROUPS } from '@/lib/tools';

const locale = 'en';
const posts = (await getCollection('blog')).sort(byDateDesc);
const KIND_ORDER = { decision: 0, basics: 1, update: 2 } as const;
// Within an area: the worked decisions first, then the basics, then dated updates; newest first.
const inArea = (index: number | null) =>
  posts
    .filter((p) => guideArea(p.data.tool) === index)
    .sort((a, b) => KIND_ORDER[a.data.kind] - KIND_ORDER[b.data.kind]);
const areas = TOOL_GROUPS.map((group, index) => ({
  id: areaId(index),
  title: group.title,
  posts: inArea(index),
})).filter((a) => a.posts.length > 0);
const general: CollectionEntry<'blog'>[] = inArea(null);
---

<BaseLayout
  locale={locale}
  title={t(locale, 'blog.title')}
  description={t(locale, 'blog.description')}
>
  <PageIntro title={t(locale, 'blog.title')} lead={t(locale, 'blog.intro')} />
  <div class="container-page pt-2 pb-10 sm:pb-12">
    <nav aria-label={t(locale, 'blog.topics')} class="mt-6">
      <ul class="flex flex-wrap gap-2" role="list">
        {areas.map((area) => (
          <li>
            <a
              href={`#${area.id}`}
              class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line-strong bg-raised px-4 text-sm font-medium text-ink transition-colors duration-(--duration-fast) ease-out-quart hover:border-accent hover:text-accent-strong"
            >
              {t(locale, area.title)}
              <span class="num text-ink-muted">{area.posts.length}</span>
            </a>
          </li>
        ))}
        {general.length > 0 && (
          <li>
            <a
              href="#basics"
              class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line-strong bg-raised px-4 text-sm font-medium text-ink transition-colors duration-(--duration-fast) ease-out-quart hover:border-accent hover:text-accent-strong"
            >
              {t(locale, 'blog.kind.basics')}
              <span class="num text-ink-muted">{general.length}</span>
            </a>
          </li>
        )}
      </ul>
    </nav>

    {areas.map((area) => (
      <section id={area.id} class="mt-10 scroll-mt-24" aria-labelledby={`${area.id}-h`}>
        <span class="rule-brass" aria-hidden="true" />
        <h2 id={`${area.id}-h`} class="mt-3 font-display text-2xl font-medium">
          {t(locale, area.title)}
        </h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {area.posts.map((post) => (
            <GuideCard locale={locale} post={post} />
          ))}
        </ul>
      </section>
    ))}

    {general.length > 0 && (
      <section id="basics" class="mt-10 scroll-mt-24" aria-labelledby="basics-h">
        <span class="rule-brass" aria-hidden="true" />
        <h2 id="basics-h" class="mt-3 font-display text-2xl font-medium">
          {t(locale, 'blog.kind.basics')}
        </h2>
        <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {general.map((post) => (
            <GuideCard locale={locale} post={post} />
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
