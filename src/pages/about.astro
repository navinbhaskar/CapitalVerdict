---
import ProsePage from '@/layouts/ProsePage.astro';
import { t } from '@/i18n/t';
import { site } from '@/config/site';
---

<ProsePage locale="en" page="about" sections={[{ key: 'why' }, { key: 'how' }, { key: 'contact' }]}>
  {site.contactEmail && (
    <section class="mt-6 max-w-3xl border-t border-line pt-5" aria-labelledby="s-email">
      <h2 id="s-email" class="font-display text-2xl font-medium">
        {t('en', 'page.about.email.title')}
      </h2>
      <p class="mt-3 max-w-(--container-prose) text-ink-muted">
        {t('en', 'page.about.email.body')}{' '}
        <a href={`mailto:${site.contactEmail}`} class="link">
          {site.contactEmail}
        </a>
      </p>
    </section>
  )}
</ProsePage>
