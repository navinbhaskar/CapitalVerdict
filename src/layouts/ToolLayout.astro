---
/**
 * Fixed anatomy for every tool page:
 *   1. H1 = the question          (title prop)
 *   2–7. Interactive tool         (default slot: an island with quick inputs, verdict + range,
 *                                  advanced inputs, chart + scenario band, what flips the answer,
 *                                  non-money checklist)
 *   8. Explanation, worked example, assumptions table, FAQ   (named slots, rendered when filled)
 *   9. Related tools              (related prop)
 * Plus a visible short disclaimer and a "Report an error" link on every tool page.
 */
import BaseLayout from './BaseLayout.astro';
import { t, type Locale } from '@/i18n/t';
import { reportErrorHref } from '@/config/site';
import { getCollection } from 'astro:content';
import Icon from '@/components/layout/Icon.astro';
import GuideCard from '@/components/blog/GuideCard.astro';
import { TOOL_GROUPS, toolKey } from '@/lib/tools';
import { TOOL_PATHS, byDateDesc } from '@/lib/blog';

interface Props {
  locale: Locale;
  /** The question the tool answers. Used as the H1. */
  title: string;
  description?: string;
  related?: { href: string; label: string }[];
  /** Questions and answers shown in the FAQ slot, repeated as FAQPage structured data. */
  faq?: { q: string; a: string }[];
}
const { locale, title, description, related = [], faq = [] } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const reportHref = reportErrorHref(pageUrl);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    url: pageUrl,
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    inLanguage: locale === 'hi' ? 'hi-IN' : 'en-IN',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  },
];
if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}

// Each related tool with its icon and one-line answer, from the tools list.
const entries = TOOL_GROUPS.flatMap((g) => g.tools);
const relatedTools = related.map((r) => {
  const entry = entries.find((e) => r.href.endsWith(e.path));
  return {
    ...r,
    icon: entry?.icon,
    gives: entry ? t(locale, toolKey(entry, 'gives')) : null,
  };
});
// Guides that lead to this calculator, newest first.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const toolId = (Object.entries(TOOL_PATHS) as [string, string][]).find(([, p]) => p === path)?.[0];
const guides = toolId
  ? (await getCollection('blog', (post) => post.data.tool === toolId)).sort(byDateDesc).slice(0, 3)
  : [];

const sections = [
  { slot: 'explanation', heading: t(locale, 'tool.section.explanation') },
  { slot: 'worked-example', heading: t(locale, 'tool.section.workedExample') },
  { slot: 'assumptions', heading: t(locale, 'tool.section.assumptions') },
  { slot: 'faq', heading: t(locale, 'tool.section.faq') },
].filter((s) => Astro.slots.has(s.slot));
---

<BaseLayout locale={locale} title={title} description={description} jsonLd={jsonLd}>
  <!-- Site search indexes the title and the written sections, not the calculator itself. -->
  <div data-pagefind-body>
    <header class="band-dark">
      <div class="container-page pt-6 pb-7 sm:pt-8 sm:pb-9">
        <span class="rule-brass" aria-hidden="true"></span>
        <h1 class="mt-4 max-w-3xl font-display text-2xl font-medium tracking-(--tracking-display) sm:text-3xl">
          {title}
        </h1>
        <p class="mt-3 max-w-2xl text-sm text-ink-muted" data-pagefind-ignore>
          {t(locale, 'tool.disclaimer')}
        </p>
      </div>
    </header>
    <article class="container-page pt-5 pb-10 sm:pt-6 sm:pb-12">
      <div data-pagefind-ignore="all">
        <slot />
      </div>

      {sections.map(({ slot, heading }) => (
        <section class="mt-8 max-w-3xl border-t border-line pt-5" aria-labelledby={`s-${slot}`}>
          <h2 id={`s-${slot}`} class="font-display text-2xl font-medium">
            {heading}
          </h2>
          <div class="mt-4 space-y-4 text-ink-muted">
            {slot === 'explanation' && <slot name="explanation" />}
            {slot === 'worked-example' && <slot name="worked-example" />}
            {slot === 'assumptions' && <slot name="assumptions" />}
            {slot === 'faq' && <slot name="faq" />}
          </div>
        </section>
      ))}

      {guides.length > 0 && (
        <section
          class="mt-8 border-t border-line pt-5"
          aria-labelledby="s-guides"
          data-pagefind-ignore="all"
        >
          <h2 id="s-guides" class="font-display text-2xl font-medium">
            {t(locale, 'tool.section.guides')}
          </h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
            {guides.map((post) => (
              <GuideCard locale={locale} post={post} />
            ))}
          </ul>
        </section>
      )}

      {relatedTools.length > 0 && (
        <nav
          class="mt-8 border-t border-line pt-5"
          aria-labelledby="s-related"
          data-pagefind-ignore="all"
        >
          <h2 id="s-related" class="font-display text-2xl font-medium">
            {t(locale, 'tool.section.related')}
          </h2>
          <ul
            class={`mt-4 grid gap-3 sm:grid-cols-2 ${relatedTools.length % 3 === 0 ? 'lg:grid-cols-3' : ''}`}
            role="list"
          >
            {relatedTools.map((r) => (
              <li>
                <a
                  href={r.href}
                  class="group flex h-full min-h-11 items-start gap-3 rounded-xl border border-line bg-raised p-4 transition-colors duration-(--duration-fast) ease-out-quart hover:border-accent"
                >
                  {r.icon && (
                    <span class="band-dark inline-flex size-9 shrink-0 items-center justify-center rounded-full text-accent">
                      <Icon name={r.icon} size={18} />
                    </span>
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block font-medium text-ink group-hover:text-accent-strong">
                      {r.label}
                    </span>
                    {r.gives && <span class="mt-0.5 block text-sm text-ink-muted">{r.gives}</span>}
                  </span>
                  <Icon
                    name="arrowRight"
                    size={18}
                    class="nudge mt-0.5 shrink-0 text-accent-strong"
                  />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {reportHref && (
        <p class="mt-6 text-sm" data-pagefind-ignore="all">
          <a href={reportHref} class="link">
            {t(locale, 'tool.reportError')}
          </a>
        </p>
      )}
    </article>
  </div>
</BaseLayout>
