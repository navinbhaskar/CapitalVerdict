---
/**
 * Text pages (methodology, about, legal). Strings live under `page.<page>.*` in the dictionaries:
 * title, description, intro, and per section `<key>.title`, `<key>.body` (paragraphs separated by
 * a blank line) and, when `formula` is set, `<key>.formula` shown as a monospaced block.
 */
import BaseLayout from './BaseLayout.astro';
import PageIntro from '@/components/layout/PageIntro.astro';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { published } from '@/lib/draft';

interface Props {
  locale: Locale;
  page: string;
  /** `bodyKey` swaps in another body string (e.g. privacy text when analytics is on). */
  sections: { key: string; formula?: boolean; bodyKey?: string }[];
  noindex?: boolean;
}
const { locale, page, sections, noindex } = Astro.props;
const k = (key: string) => published(t(locale, `page.${page}.${key}` as MessageKey));
// A section whose body is still a placeholder is left out until its copy is written.
const shown = sections
  .map((s) => ({ ...s, body: k(s.bodyKey ?? `${s.key}.body`) }))
  .filter((s) => s.body !== '');
---

<BaseLayout locale={locale} title={k('title')} description={k('description')} noindex={noindex}>
  <PageIntro title={k('title')} lead={k('intro')} />
  <article class="container-page pt-2 pb-10 sm:pb-12">
    {shown.map(({ key, formula, body }) => (
      <section class="mt-6 max-w-3xl border-t border-line pt-5" aria-labelledby={`s-${key}`}>
        <h2 id={`s-${key}`} class="font-display text-xl font-semibold">
          {k(`${key}.title`)}
        </h2>
        <div class="mt-3 max-w-(--container-prose) space-y-3 text-ink-muted">
          {body.split('\n\n').map((p) => (
            <p>{p}</p>
          ))}
        </div>
        {formula && (
          <pre
            class="num mt-4 overflow-x-auto rounded-lg bg-surface px-4 py-3 text-sm text-ink"
            set:text={k(`${key}.formula`)}
          />
        )}
      </section>
    ))}

    <slot />
  </article>
</BaseLayout>
