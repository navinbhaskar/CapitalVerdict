---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Motion from '@/components/layout/Motion.astro';
import { htmlLang, t, type Locale } from '@/i18n/t';
import { PUBLISHED_LOCALES, alternates, splitLocale } from '@/i18n/routes';
import { validateAllData } from '@/data/schema';
import { site } from '@/config/site';
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

// Server-only: a malformed data file fails the build.
validateAllData();

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Structured data objects, each rendered as its own JSON-LD script. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { locale, title, description, jsonLd = [], noindex = false } = Astro.props;
const { path } = splitLocale(Astro.url.pathname);
const siteName = t(locale, 'site.name');
const pageTitle = title ? `${title} | ${siteName}` : `${siteName}: ${t(locale, 'site.tagline')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const metaDescription = description ?? t(locale, 'site.description');
// Link-preview image: the tool's own card on tool pages, the notes card on the blog, else the site card.
const OG_FOR: [string, string][] = [
  ['/tools/car-fuel', 'car-fuel'],
  ['/tools/solar', 'solar'],
  ['/tools/rent-vs-buy', 'rent-vs-buy'],
  ['/tools/prepay-or-invest', 'prepay-or-invest'],
  ['/tools/cash-or-car-loan', 'cash-or-car-loan'],
  ['/guides', 'blog'],
];
const ogName = OG_FOR.find(([prefix]) => path.startsWith(prefix))?.[1] ?? 'default';
const ogImage = new URL(`/og/${ogName}.png`, Astro.site).href;
// JSON in a script tag: escape "<" so no string can close the tag.
const ld = (o: Record<string, unknown>) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0f2a22" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        const root = document.documentElement;
        try {
          if (localStorage.getItem('dw.theme') === 'dark') {
            root.dataset.theme = 'dark';
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#12302a');
          }
        } catch {
          // Storage blocked: stay on the light theme.
        }
        // Logo intro plays on the first page of a visit only.
        try {
          if (!sessionStorage.getItem('dw.logoIntro')) {
            root.classList.add('logo-intro');
            sessionStorage.setItem('dw.logoIntro', '1');
          }
        } catch {
          // Storage blocked: skip the intro rather than replay it on every page.
        }
        // Scroll reveals hide content only when the observer exists to show it again.
        if ('IntersectionObserver' in window) root.classList.add('js-reveal');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((o) => (
      <script type="application/ld+json" set:html={ld(o)} />
    ))}
    {PUBLISHED_LOCALES.length > 1 &&
      alternates(path, Astro.site!, PUBLISHED_LOCALES).map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- The guides feed: no visible link, but feed readers find it from any page. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t(locale, 'blog.title')}: ${siteName}`}
      href="/guides/rss.xml"
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary"
    >
      {t(locale, 'a11y.skipToContent')}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <Motion />
    {site.analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}
      />
    )}
  </body>
</html>
