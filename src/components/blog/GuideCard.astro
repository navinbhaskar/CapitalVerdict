---
/**
 * One guide as a card: its headline figure (when it has one), title, a short description, and a
 * small line with the kind of guide and the reading time. The whole card is the link.
 */
import type { CollectionEntry } from 'astro:content';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { readingMinutes } from '@/lib/blog';

interface Props {
  locale: Locale;
  post: CollectionEntry<'blog'>;
  /** Heading level for the title, so the card fits the page outline. */
  level?: 'h3' | 'h4';
  /** A smaller card for long lists: tighter spacing, smaller figure and title. */
  compact?: boolean;
  /** The area of life the guide belongs to, shown above it (e.g. "Your vehicle"). */
  area?: string;
  /** Lets a list filter cards by area. */
  'data-area'?: string;
}
const { locale, post, level = 'h3', compact = false, area, 'data-area': dataArea } = Astro.props;
const Heading = level;
const { title, description, kind, takeaway, updated } = post.data;
const dateFormat = new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeZone: 'UTC' });
---

<li
  data-area={dataArea}
  class:list={[
    'card-lift relative flex flex-col rounded-xl border border-line bg-raised transition-colors duration-(--duration-base) ease-out-quart hover:border-accent',
    compact ? 'p-3.5 sm:p-4' : 'p-4 sm:p-5',
  ]}
>
  {area && <p class="mb-2 text-xs font-medium text-accent-strong">{area}</p>}
  {takeaway && (
    <p class:list={['border-b border-line', compact ? 'mb-2.5 pb-2.5' : 'mb-3 pb-3']}>
      <span
        class:list={[
          'block font-display font-medium tracking-(--tracking-heading) text-accent-strong num',
          compact ? 'text-xl' : 'text-2xl',
        ]}
      >
        {takeaway.figure}
      </span>
      <span class:list={['mt-0.5 block text-ink-muted', compact ? 'text-xs' : 'text-sm']}>
        {takeaway.label}
      </span>
    </p>
  )}
  <Heading
    class:list={[
      'font-display font-medium tracking-(--tracking-heading) text-balance',
      compact ? 'text-lg' : 'text-xl',
    ]}
  >
    <a
      href={`/guides/${post.id}/`}
      class="after:absolute after:inset-0 after:rounded-xl hover:text-accent-strong"
    >
      {title}
    </a>
  </Heading>
  <p
    class:list={['mt-1.5 flex-1 text-sm text-ink-muted', compact ? 'line-clamp-2' : 'line-clamp-3']}
  >
    {description}
  </p>
  <p
    class:list={[
      'flex flex-wrap items-center gap-x-3 gap-y-1 text-ink-muted',
      compact ? 'mt-2.5 text-xs' : 'mt-3 text-sm',
    ]}
  >
    <span class="rounded-full bg-surface px-2 py-0.5 text-xs font-medium text-ink">
      {t(locale, `blog.kindShort.${kind}` as MessageKey)}
    </span>
    <span class="num">
      {t(locale, 'blog.minutes', { n: readingMinutes(post.body ?? '') })}
      {updated && <>, {t(locale, 'blog.updated', { date: dateFormat.format(updated) })}</>}
    </span>
  </p>
</li>
