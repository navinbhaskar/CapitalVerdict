---
import { t } from '@/i18n/t';

/** The guide's answer in a few lines, before the working. Markdown inside keeps article styles. */
---

<aside class="mt-6 mb-8 rounded-xl bg-surface p-4 sm:p-5" aria-labelledby="in-short">
  <p id="in-short" class="flex items-center gap-3 font-display text-xl font-medium">
    <span class="rule-brass" aria-hidden="true"></span>
    {t('en', 'guide.inShort')}
