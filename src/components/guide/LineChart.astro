---
import type { LineData } from '@/content/guideFigures';
import { formatINR } from '@/lib/format';
import { formatMoney, formatMoneyShort } from '@/lib/formatTool';
import { t } from '@/i18n/t';
import Figure from './Figure.astro';

/**
 * A static line chart for a guide: no script, drawn at build time. The lines are SVG stretched to
 * the frame (strokes stay crisp with non-scaling-stroke); the axis labels are HTML, so text stays
 * readable at any width. Every point is also in the table under "See the numbers", which is what
 * screen readers get.
 */
interface Props {
  title: string;
  data: LineData;
  /** What the x-axis counts, under the axis, e.g. "Salary". */
  xTitle?: string;
  /** What a gap in a line means, for the table, e.g. "Never". */
  missing?: string;
  note?: string;
}
const { title, data, xTitle, missing = '–', note } = Astro.props;

const values = data.series.flatMap((s) => s.values).filter((v): v is number => v !== null);
const rawMin = Math.min(0, ...values);
const rawMax = Math.max(0, ...values);

/** A round step that gives about four gridlines. */
function niceStep(span: number): number {
  const rough = span / 4;
  const mag = Math.pow(10, Math.floor(Math.log10(rough)));
  const n = rough / mag;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * mag;
}
const step = niceStep(rawMax - rawMin || 1);
const min = Math.floor(rawMin / step) * step;
const max = Math.ceil(rawMax / step) * step;
const gridlines = Array.from(
  { length: Math.round((max - min) / step) + 1 },
  (_, i) => min + i * step,
);

const n = data.xLabels.length;
const x = (i: number) => (n === 1 ? 50 : (i / (n - 1)) * 100);
const y = (v: number) => 100 - ((v - min) / (max - min)) * 100;
const tickLabel = (v: number) => (Math.abs(v) >= 1e5 ? formatMoneyShort(v) : formatINR(v));

/** Each series as runs of points, broken where a value is missing. */
const paths = data.series.map((s) => {
  const runs: string[] = [];
  let run: string[] = [];
  s.values.forEach((v, i) => {
    if (v === null) {
      if (run.length) runs.push(run.join(' '));
      run = [];
    } else run.push(`${x(i).toFixed(2)},${y(v).toFixed(2)}`);
  });
  if (run.length) runs.push(run.join(' '));
  return { ...s, runs };
});

const stroke = { accent: 'stroke-accent', ink: 'stroke-ink', muted: 'stroke-ink-subtle' } as const;
/** On phones only the first, middle and last labels fit. */
const phoneTick = (k: number) =>
  data.ticks.length <= 3 ||
  k === 0 ||
  k === data.ticks.length - 1 ||
  k === Math.floor((data.ticks.length - 1) / 2);
const align = (i: number) =>
  i === 0 ? 'translate-x-0' : i === n - 1 ? '-translate-x-full' : '-translate-x-1/2';
---

<Figure title={title} note={note}>
  <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm" role="list">
    {paths.map((s) => (
      <li class="flex items-center gap-2">
        <svg width="24" height="8" viewBox="0 0 24 8" aria-hidden="true" class="shrink-0">
          <line
            x1="0"
            y1="4"
            x2="24"
            y2="4"
            class={stroke[s.tone]}
            stroke-width="2.5"
            stroke-dasharray={s.dashed ? '4 3' : undefined}
          />
        </svg>
        <span class={s.tone === 'accent' ? 'font-medium' : 'text-ink-muted'}>{s.label}</span>
      </li>
    ))}
  </ul>

  <div class="mt-4 flex" aria-hidden="true">
    <div class="relative w-16 shrink-0">
      {gridlines.map((g) => (
        <span
          class="num absolute right-2 -translate-y-1/2 text-xs whitespace-nowrap text-ink-muted"
          style={{ top: `${y(g)}%` }}
        >
          {tickLabel(g)}
        </span>
      ))}
    </div>
    <div class="relative h-52 min-w-0 flex-1 sm:h-60">
      <svg
        class="absolute inset-0 h-full w-full overflow-visible"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        {gridlines.map((g) => (
          <line
            x1="0"
            x2="100"
            y1={y(g)}
            y2={y(g)}
            class={g === 0 ? 'stroke-line-strong' : 'stroke-line'}
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
        ))}
        {paths.map((s) =>
          s.runs.map((points) => (
            <polyline
              points={points}
              fill="none"
              class={stroke[s.tone]}
              stroke-width={s.tone === 'accent' ? 2.5 : 2}
              stroke-linejoin="round"
              stroke-linecap="round"
              stroke-dasharray={s.dashed ? '5 4' : undefined}
              vector-effect="non-scaling-stroke"
            />
          )),
        )}
      </svg>
    </div>
  </div>
  <div class="relative mt-2 ml-16 h-5" aria-hidden="true">
    {data.ticks.map((i, k) => (
      <span
        class={`num absolute top-0 text-xs whitespace-nowrap text-ink-muted ${align(i)} ${phoneTick(k) ? '' : 'max-sm:hidden'}`}
        style={{ left: `${x(i)}%` }}
      >
        {data.xLabels[i]}
      </span>
    ))}
  </div>
  {xTitle && <p class="mt-1 ml-16 text-center text-xs text-ink-muted">{xTitle}</p>}

  <details class="group mt-4 border-t border-line pt-1">
    <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 text-sm text-accent-strong hover:underline">
      <svg
        class="size-4 transition-transform duration-(--duration-fast) group-open:rotate-90"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M6 3.5 10.5 8 6 12.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {t('en', 'guide.seeNumbers')}
    </summary>
    <div class="mt-1 max-h-80 overflow-auto" tabindex="0" role="region" aria-label={title}>
      <table class="num w-full border-collapse text-sm">
        <thead class="sticky top-0 bg-raised">
          <tr class="border-b border-line-strong text-ink-muted">
            <th scope="col" class="py-2 pr-4 text-left font-medium">
              {xTitle ?? ''}
            </th>
            {data.series.map((s) => (
              <th scope="col" class="py-2 pl-4 text-right font-medium">
                {s.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {data.xLabels.map((label, i) => (
            <tr class="border-b border-line last:border-b-0">
              <th scope="row" class="py-1.5 pr-4 text-left font-normal">
                {label}
              </th>
              {data.series.map((s) => (
                <td class="py-1.5 pl-4 text-right">
                  {s.values[i] === null ? missing : formatMoney(s.values[i]!)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</Figure>
