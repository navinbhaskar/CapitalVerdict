---
import ToolLayout from '@/layouts/ToolLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import AssumptionsTable, { type AssumptionRow } from '@/components/tool/AssumptionsTable.astro';
import ScooterTool from '@/components/islands/ScooterTool';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { defaults, dlTariff, evTwoWheeler, fuelPrices } from '@/data';
import { formatINR } from '@/lib/format';
import { formatPercent } from '@/lib/formatTool';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const loan = defaults.globalAssumptions.carLoanRate;
const rise = defaults.scenarioVariables.energyPriceRise;
const today = new Date().toISOString().slice(0, 10);
const central = evTwoWheeler.central;
const dl = evTwoWheeler.states.find((x) => x.state === 'DL')!;
const year =
  dl.purchase.years.find((y) => today >= y.from && today <= y.until) ?? dl.purchase.years[0]!;
const delhiPetrol = fuelPrices.cities.find((c) => c.id === 'delhi')!.petrol;
const sourced = (
  label: string,
  value: string,
  r: { source: string; effectiveDate: string; status: string },
): AssumptionRow => ({
  label,
  value,
  source: r.source,
  date: r.effectiveDate,
  verified: r.status === 'verified',
});
const rows: AssumptionRow[] = [
  sourced(
    t(locale, 'assumptionsTable.dlPetrol'),
    delhiPetrol.value === null ? '—' : `₹${delhiPetrol.value}/L`,
    delhiPetrol,
  ),
  sourced(
    t(locale, 'assumptionsTable.dlTariff'),
    t(locale, 'assumptionsTable.dlTariffValue'),
    dlTariff,
  ),
  ...(dlTariff.subsidy
    ? [
        sourced(
          t(locale, 'assumptionsTable.dlSubsidy'),
          t(locale, 'assumptionsTable.dlSubsidyValue', {
            full: dlTariff.subsidy.fullUpToUnits,
            partial: dlTariff.subsidy.partialUpToUnits,
            cap: formatINR(dlTariff.subsidy.partialCapPerMonth),
          }),
          dlTariff.subsidy,
        ),
      ]
    : []),
  sourced(
    t(locale, 'assumptionsTable.pmEdrive'),
    t(locale, 'assumptionsTable.pmEdriveValue', {
      perKWh: formatINR(central.perKWh).replace('₹', ''),
      cap: formatINR(central.capPerVehicle).replace('₹', ''),
    }),
    central,
  ),
  sourced(
    t(locale, 'assumptionsTable.dlEv2w'),
    t(locale, 'assumptionsTable.dlEv2wValue', {
      perKWh: formatINR(year.perKWh).replace('₹', ''),
      cap: formatINR(year.cap).replace('₹', ''),
    }),
    dl.purchase,
  ),
  ...(dl.scrapping
    ? [
        sourced(
          t(locale, 'assumptionsTable.dlScrapping'),
          formatINR(dl.scrapping.amount),
          dl.scrapping,
        ),
      ]
    : []),
  ...(dl.roadTaxWaiver
    ? [
        sourced(
          t(locale, 'assumptionsTable.dlRoadTax'),
          t(locale, 'assumptionsTable.dlRoadTaxValue'),
          dl.roadTaxWaiver,
        ),
      ]
    : []),
  {
    label: t(locale, 'ac.in.tariffRise'),
    value: [rise.values.pessimistic, rise.values.base, rise.values.optimistic]
      .map(formatPercent)
      .join(' / '),
    source: rise.source,
    date: rise.effectiveDate,
    verified: rise.status === 'verified',
  },
  {
    label: t(locale, 'ac.in.interestRate'),
    value: loan.value === null ? '—' : formatPercent(loan.value),
    source: loan.source,
    date: loan.effectiveDate,
    verified: loan.status === 'verified',
  },
];

const FAQ = [1, 2, 3] as const;
const related = [
  { href: localizePath('/tools/car-fuel/', locale), label: t(locale, 'tool.carFuel.title') },
  { href: localizePath('/tools/ac-payback/', locale), label: t(locale, 'tool.ac.title') },
  { href: localizePath('/tools/solar/', locale), label: t(locale, 'tool.solar.title') },
];
---

<ToolLayout
  locale={locale}
  title={t(locale, 'tool.scooter.question')}
  description={t(locale, 'scooter.metaDescription')}
  related={related}
  faq={FAQ.map((n) => ({
    q: t(locale, `scooter.faq.${n}.q` as MessageKey),
    a: t(locale, `scooter.faq.${n}.a` as MessageKey),
  }))}
>
  <ScooterTool client:load locale={locale} />

  <p slot="explanation">{t(locale, 'scooter.explanation')}</p>

  <AssumptionsTable slot="assumptions" locale={locale} rows={rows} />

  <div slot="faq" class="divide-y divide-line border-y border-line">
    {FAQ.map((n) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2.5 font-medium text-ink">
          {t(locale, `scooter.faq.${n}.q` as MessageKey)}
          <Icon
            name="chevronDown"
            size={18}
            class="shrink-0 text-ink-muted transition-transform duration-(--duration-base) ease-out-quart group-open:rotate-180"
          />
        </summary>
        <p class="max-w-(--container-prose) pb-3 text-sm">
          {t(locale, `scooter.faq.${n}.a` as MessageKey)}
        </p>
      </details>
    ))}
  </div>
</ToolLayout>
