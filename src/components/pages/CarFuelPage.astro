---
import ToolLayout from '@/layouts/ToolLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import AssumptionsTable, { type AssumptionRow } from '@/components/tool/AssumptionsTable.astro';
import CarFuelTool from '@/components/islands/CarFuelTool';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { defaults, fuelPrices } from '@/data';
import { compareCarFuel } from '@/models/carFuel';
import { carFuelExample } from '@/models/carFuel.example';
import { formatMoney, formatNumber, formatPercent, formatRupeesPrecise } from '@/lib/formatTool';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const rise = defaults.scenarioVariables.energyPriceRise;
const loan = defaults.globalAssumptions.carLoanRate;
const cityPrice =
  fuelPrices.cities.find((c) => c.petrol.status !== 'verified')?.petrol ??
  fuelPrices.cities[0]!.petrol;
const verifiedCities = fuelPrices.cities.filter(
  (c) => c.petrol.status === 'verified' && c.cng.status === 'verified',
);
const unverifiedCities = fuelPrices.cities.filter((c) => !verifiedCities.includes(c));
const rows: AssumptionRow[] = [
  ...verifiedCities.map((c) => ({
    label: t(locale, 'assumptionsTable.cityPricesFor', {
      city: t(locale, `city.${c.id}` as MessageKey),
    }),
    value: `${t(locale, 'unit.perLitre', { n: c.petrol.value! })}, ${t(locale, 'unit.perKg', { n: c.cng.value! })}`,
    source: `${c.petrol.source} ${c.cng.source}`,
    date: c.petrol.effectiveDate,
    verified: true,
  })),
  {
    label: t(locale, 'assumptionsTable.priceRise'),
    value: [rise.values.pessimistic, rise.values.base, rise.values.optimistic]
      .map(formatPercent)
      .join(' / '),
    source: rise.source,
    date: rise.effectiveDate,
    verified: rise.status === 'verified',
  },
  {
    label: t(locale, 'assumptionsTable.carLoanRate'),
    value: loan.value === null ? '—' : formatPercent(loan.value),
    source: loan.source,
    date: loan.effectiveDate,
    verified: loan.status === 'verified',
  },
  ...(unverifiedCities.length > 0
    ? [
        {
          label: t(locale, 'assumptionsTable.otherCities'),
          value: unverifiedCities.map((c) => t(locale, `city.${c.id}` as MessageKey)).join(', '),
          source: cityPrice.source,
          date: cityPrice.effectiveDate,
          verified: false,
        },
      ]
    : []),
];

const ex = compareCarFuel(carFuelExample);
const cngName = { alt: t(locale, 'fuel.cng') };
const worked: [string, string][] = [
  [
    t(locale, 'input.monthlyKm'),
    t(locale, 'unit.km', { n: formatNumber(carFuelExample.monthlyKm) }),
  ],
  [
    t(locale, 'input.extraPrice', { altCar: t(locale, 'fuel.cngCar') }),
    formatMoney(carFuelExample.extraPrice),
  ],
  [t(locale, 'input.interestRate'), formatPercent(carFuelExample.interestRate)],
  [
    t(locale, 'stat.costPerKm'),
    t(locale, 'stat.costPerKmValue', {
      base: formatRupeesPrecise(ex.costPerKm.base),
      alt: formatRupeesPrecise(ex.costPerKm.alternative),
    }),
  ],
  [t(locale, 'stat.monthlySaving', cngName), formatMoney(ex.firstMonthSaving)],
  [
    t(locale, 'stat.breakevenNoInterest'),
    t(locale, 'unit.months', { n: formatNumber(ex.breakevenNoInterest!.fractionalMonths, 1) }),
  ],
  [
    t(locale, 'home.preview.breakeven'),
    `${t(locale, 'unit.months', { n: ex.breakevenWithInterest!.months })}, ${t(locale, 'unit.km', { n: formatNumber(ex.breakevenWithInterest!.km) })}`,
  ],
  [t(locale, 'stat.net10', cngName), formatMoney(ex.netAt10Years!.withInterest)],
];

const FAQ = [1, 2, 3, 4] as const;

const related = [
  { href: localizePath('/tools/solar/', locale), label: t(locale, 'tool.solar.title') },
  { href: localizePath('/tools/rent-vs-buy/', locale), label: t(locale, 'tool.rentVsBuy.title') },
  {
    href: localizePath('/tools/cash-or-car-loan/', locale),
    label: t(locale, 'tool.carLoan.title'),
  },
];
---

<ToolLayout
  locale={locale}
  title={t(locale, 'tool.carFuel.question')}
  description={t(locale, 'carFuel.metaDescription')}
  related={related}
  faq={FAQ.map((n) => ({
    q: t(locale, `carFuel.faq.${n}.q` as MessageKey),
    a: t(locale, `carFuel.faq.${n}.a` as MessageKey),
  }))}
>
  <CarFuelTool client:load locale={locale} />

  <p slot="explanation">{t(locale, 'carFuel.explanation')}</p>

  <Fragment slot="worked-example">
    <p>{t(locale, 'carFuel.workedExample.intro')}</p>
    <dl class="grid gap-x-8 sm:grid-cols-2">
      {worked.map(([label, value]) => (
        <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
          <dt>{label}</dt>
          <dd class="num font-medium text-ink">{value}</dd>
        </div>
      ))}
    </dl>
  </Fragment>

  <AssumptionsTable slot="assumptions" locale={locale} rows={rows} />

  <div slot="faq" class="divide-y divide-line border-y border-line">
    {FAQ.map((n) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2.5 font-medium text-ink">
          {t(locale, `carFuel.faq.${n}.q` as MessageKey)}
          <Icon
            name="chevronDown"
            size={18}
            class="shrink-0 text-ink-muted transition-transform duration-(--duration-base) ease-out-quart group-open:rotate-180"
          />
        </summary>
        <p class="max-w-(--container-prose) pb-3 text-sm">
          {t(locale, `carFuel.faq.${n}.a` as MessageKey)}
        </p>
      </details>
    ))}
  </div>
</ToolLayout>
