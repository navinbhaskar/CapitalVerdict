---
import ToolLayout from '@/layouts/ToolLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import AssumptionsTable, { type AssumptionRow } from '@/components/tool/AssumptionsTable.astro';
import SolarTool from '@/components/islands/SolarTool';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { defaults, dlSolarData, dlTariff, solarData, upTariff } from '@/data';
import { formatINR } from '@/lib/format';
import { formatPercent } from '@/lib/formatTool';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const record = (label: MessageKey, r: (typeof solarData)['subsidy']): AssumptionRow => ({
  label: t(locale, label),
  value: r.value === null ? '—' : `${r.value} ${r.unit}`,
  source: r.source,
  date: r.effectiveDate,
  verified: r.status === 'verified',
});
const rise = defaults.scenarioVariables.energyPriceRise;
const dl = dlSolarData;
const sourced = (
  label: MessageKey,
  value: string,
  r: { source: string; effectiveDate: string; status: string },
): AssumptionRow => ({
  label: t(locale, label),
  value,
  source: r.source,
  date: r.effectiveDate,
  verified: r.status === 'verified',
});
// Delhi first: the tool's default state, with verified figures.
const delhiRows: AssumptionRow[] = [
  sourced('assumptionsTable.dlTariff', t(locale, 'assumptionsTable.dlTariffValue'), dlTariff),
  ...(dlTariff.subsidy
    ? [
        sourced(
          'assumptionsTable.dlSubsidy',
          t(locale, 'assumptionsTable.dlSubsidyValue', {
            full: dlTariff.subsidy.fullUpToUnits,
            partial: dlTariff.subsidy.partialUpToUnits,
            cap: formatINR(dlTariff.subsidy.partialCapPerMonth),
          }),
          dlTariff.subsidy,
        ),
      ]
    : []),
  ...(dl.centralSubsidy
    ? [
        sourced(
          'assumptionsTable.dlSolarSubsidy',
          t(locale, 'assumptionsTable.dlSolarSubsidyValue', {
            capital: formatINR(dl.stateCapitalSubsidy?.perKW ?? 0),
            max: formatINR(dl.stateCapitalSubsidy?.max ?? 0),
          }),
          dl.centralSubsidy,
        ),
      ]
    : []),
  ...(dl.generationIncentive
    ? [
        sourced(
          'assumptionsTable.dlIncentive',
          dl.generationIncentive.bands.map((b) => `${formatINR(b.perKWh)}/kWh`).join(' / '),
          dl.generationIncentive,
        ),
      ]
    : []),
  record('assumptionsTable.dlGeneration', dl.generationPerKWPerDay),
  record('assumptionsTable.dlExport', dl.exportRatePerKWh),
];
const rows: AssumptionRow[] = [
  ...delhiRows,
  {
    label: t(locale, 'assumptionsTable.upTariff'),
    value: '—',
    source: upTariff.source,
    date: upTariff.effectiveDate,
    verified: upTariff.status === 'verified',
  },
  record('assumptionsTable.solarSubsidy', solarData.subsidy),
  record('assumptionsTable.solarGeneration', solarData.generationPerKWPerDay),
  record('assumptionsTable.solarDegradation', solarData.degradationPerYear),
  record('assumptionsTable.solarExport', solarData.exportRatePerKWh),
  {
    label: t(locale, 'assumptionsTable.tariffRise'),
    value: [rise.values.pessimistic, rise.values.base, rise.values.optimistic]
      .map(formatPercent)
      .join(' / '),
    source: rise.source,
    date: rise.effectiveDate,
    verified: rise.status === 'verified',
  },
];

const FAQ = [1, 2, 3] as const;
const related = [
  { href: localizePath('/tools/car-fuel/', locale), label: t(locale, 'tool.carFuel.title') },
  { href: localizePath('/tools/rent-vs-buy/', locale), label: t(locale, 'tool.rentVsBuy.title') },
  { href: localizePath('/tools/ac-payback/', locale), label: t(locale, 'tool.ac.title') },
];
---

<ToolLayout
  locale={locale}
  title={t(locale, 'tool.solar.question')}
  description={t(locale, 'solar.metaDescription')}
  related={related}
  faq={FAQ.map((n) => ({
    q: t(locale, `solar.faq.${n}.q` as MessageKey),
    a: t(locale, `solar.faq.${n}.a` as MessageKey),
  }))}
>
  <SolarTool client:load locale={locale} />

  <p slot="explanation">{t(locale, 'solar.explanation')}</p>

  <AssumptionsTable slot="assumptions" locale={locale} rows={rows} />

  <div slot="faq" class="divide-y divide-line border-y border-line">
    {FAQ.map((n) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2.5 font-medium text-ink">
          {t(locale, `solar.faq.${n}.q` as MessageKey)}
          <Icon
            name="chevronDown"
            size={18}
            class="shrink-0 text-ink-muted transition-transform duration-(--duration-base) ease-out-quart group-open:rotate-180"
          />
        </summary>
        <p class="max-w-(--container-prose) pb-3 text-sm">
          {t(locale, `solar.faq.${n}.a` as MessageKey)}
        </p>
      </details>
    ))}
  </div>
</ToolLayout>
