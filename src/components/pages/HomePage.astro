---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { compareCarFuel } from '@/models/carFuel';
import { carFuelExample } from '@/models/carFuel.example';
import { formatLakhCrore } from '@/lib/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const tools: { title: MessageKey; question: MessageKey; icon: 'fuel' | 'home' | 'sun' }[] = [
  { title: 'tool.carFuel.title', question: 'tool.carFuel.question', icon: 'fuel' },
  { title: 'tool.rentVsBuy.title', question: 'tool.rentVsBuy.question', icon: 'home' },
  { title: 'tool.solar.title', question: 'tool.solar.question', icon: 'sun' },
];

const principles: { title: MessageKey; body: MessageKey }[] = [
  { title: 'principle.assumptions.title', body: 'principle.assumptions.body' },
  { title: 'principle.conservative.title', body: 'principle.conservative.body' },
  { title: 'principle.realTerms.title', body: 'principle.realTerms.body' },
  { title: 'principle.noProducts.title', body: 'principle.noProducts.body' },
];

// Hero preview: the spec's worked example, computed by the real model so it can never drift.
const example = compareCarFuel(carFuelExample);
const breakeven = example.breakevenWithInterest!;
const months = carFuelExample.horizonMonths;
const W = 320;
const H = 132;
const top =
  Math.max(example.cumulativeSaving[months]!, example.extraPriceWithInterest[months]!) * 1.08;
const x = (m: number) => (m / months) * W;
const y = (v: number) => H - (v / top) * H;
const line = (series: number[]) =>
  series
    .filter((_, m) => m % 2 === 0 || m === months)
    .map((v, i, arr) => {
      const m = i === arr.length - 1 ? months : i * 2;
      return `${i === 0 ? 'M' : 'L'}${x(m).toFixed(1)} ${y(v).toFixed(1)}`;
    })
    .join(' ');
const savingPath = line(example.cumulativeSaving);
const costPath = line(example.extraPriceWithInterest);
const savingArea = `${savingPath} L${W} ${H} L0 ${H} Z`;
const beX = x(breakeven.months);
const beY = y(example.cumulativeSaving[breakeven.months]!);
const nf = new Intl.NumberFormat('en-IN');
const stats = [
  {
    label: t(locale, 'home.preview.breakeven'),
    value: t(locale, 'unit.monthsShort', { n: breakeven.months }),
  },
  {
    label: t(locale, 'home.preview.distance'),
    value: t(locale, 'unit.km', { n: nf.format(breakeven.km) }),
  },
  {
    label: t(locale, 'home.preview.net10'),
    value: formatLakhCrore(example.netAt10Years!.withInterest),
  },
];
---

<BaseLayout locale={locale}>
  <section class="relative overflow-hidden">
    <div class="bg-graph pointer-events-none absolute inset-0 opacity-70" aria-hidden="true"></div>
    <div class="container-page relative grid items-center gap-14 pt-14 pb-20 sm:pt-20 sm:pb-24 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div>
        <h1 class="max-w-xl text-[2.375rem] leading-[1.08] font-semibold tracking-[-0.025em] sm:text-[3.25rem]">
          {t(locale, 'site.tagline')}
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-muted">
          {t(locale, 'home.intro')}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#tools"
            class="inline-flex min-h-12 items-center gap-2 rounded-lg bg-primary px-6 font-medium text-on-primary shadow-[var(--shadow-card)] transition-colors duration-200 hover:bg-primary-hover"
          >
            {t(locale, 'home.cta')}
            <Icon name="arrowRight" size={18} />
          </a>
          <a
            href="#principles"
            class="inline-flex min-h-12 items-center rounded-lg px-5 font-medium text-ink-muted transition-colors duration-200 hover:bg-surface hover:text-ink"
          >
            {t(locale, 'home.secondaryCta')}
          </a>
        </div>
      </div>

      <!-- Product preview. Decorative: the same numbers are explained on the tool page. -->
      <figure
        class="relative w-full max-w-md justify-self-center rounded-2xl border border-line bg-page p-5 shadow-[var(--shadow-raised)] sm:p-6 lg:justify-self-end"
        aria-hidden="true"
      >
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm font-medium text-ink-muted">{t(locale, 'home.preview.title')}</span>
          <span class="rounded-full border border-line px-2.5 py-0.5 text-xs font-medium text-ink-muted">
            {t(locale, 'home.preview.label')}
          </span>
        </div>
        <p class="mt-3 text-[1.375rem] leading-snug font-semibold tracking-[-0.01em]">
          {t(locale, 'home.preview.verdict', { months: breakeven.months })}
        </p>

        <svg viewBox={`0 0 ${W} ${H + 18}`} class="mt-5 w-full overflow-visible" fill="none">
          {[0.25, 0.5, 0.75].map((f) => (
            <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="var(--color-line)" />
          ))}
          <line x1="0" x2={W} y1={H} y2={H} stroke="var(--color-line-strong)" />
          <path d={savingArea} fill="var(--color-accent)" fill-opacity="0.08"></path>
          <path
            d={costPath}
            stroke="var(--color-ink-subtle)"
            stroke-width="2"
            stroke-dasharray="5 5"
            stroke-linecap="round"
          ></path>
          <path
            d={savingPath}
            stroke="var(--color-ink)"
            stroke-width="2.25"
            stroke-linecap="round"
          ></path>
          <line
            x1={beX}
            x2={beX}
            y1={beY}
            y2={H}
            stroke="var(--color-accent)"
            stroke-width="1.5"
            stroke-dasharray="2 4"
          ></line>
          <circle cx={beX} cy={beY} r="11" fill="var(--color-accent)" fill-opacity="0.15"></circle>
          <circle cx={beX} cy={beY} r="5" fill="var(--color-accent)"></circle>
          <text
            x="0"
            y={H + 15}
            font-size="11"
            fill="var(--color-ink-subtle)"
            font-family="inherit"
          >
            0
          </text>
          <text
            x={W}
            y={H + 15}
            font-size="11"
            fill="var(--color-ink-subtle)"
            text-anchor="end"
            font-family="inherit"
          >
            {t(locale, 'unit.yearsShort', { n: months / 12 })}
          </text>
        </svg>

        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted">
          <span class="inline-flex items-center gap-2">
            <span class="h-0.5 w-4 rounded bg-ink"></span>
            {t(locale, 'home.preview.legendSaving')}
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="w-4 border-t-2 border-dashed border-ink-subtle"></span>
            {t(locale, 'home.preview.legendCost')}
          </span>
        </div>

        <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line pt-5">
          {stats.map((s) => (
            <div>
              <dt class="text-xs text-ink-muted">{s.label}</dt>
              <dd class="num mt-1 text-base font-semibold sm:text-lg">{s.value}</dd>
            </div>
          ))}
        </dl>
      </figure>
    </div>
  </section>

  <section id="tools" class="scroll-mt-20 border-y border-line bg-surface">
    <div class="container-page py-16 sm:py-24">
      <h2 class="text-[1.75rem] font-semibold tracking-[-0.02em] sm:text-[2rem]">
        {t(locale, 'home.tools.heading')}
      </h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {tools.map((tool) => (
          <li>
            <article class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-page p-6 shadow-[var(--shadow-card)] transition-[border-color,box-shadow] duration-200 hover:border-line-strong hover:shadow-[var(--shadow-raised)]">
              <span class="inline-flex size-11 items-center justify-center rounded-lg border border-line bg-surface text-ink">
                <Icon name={tool.icon} size={22} />
              </span>
              <h3 class="mt-6 text-lg font-semibold">{t(locale, tool.title)}</h3>
              <p class="mt-1.5 flex-1 text-[0.9375rem] text-ink-muted">
                {t(locale, tool.question)}
              </p>
              <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
                <span class="inline-flex items-center gap-2 text-sm font-medium text-ink-muted">
                  <span class="size-1.5 rounded-full bg-accent" />
                  {t(locale, 'home.tools.status.soon')}
                </span>
                <Icon name="arrowUpRight" size={18} class="text-ink-subtle" />
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="principles" class="container-page scroll-mt-20 py-16 sm:py-24">
    <h2 class="text-[1.75rem] font-semibold tracking-[-0.02em] sm:text-[2rem]">
      {t(locale, 'home.principles.heading')}
    </h2>
    <ol class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {principles.map((p, i) => (
        <li class="border-t border-line-strong pt-5">
          <span class="num text-sm font-medium text-accent-strong">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 font-semibold">{t(locale, p.title)}</h3>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted">{t(locale, p.body)}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
