---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { compareCarFuel } from '@/models/carFuel';
import { carFuelExample } from '@/models/carFuel.example';
import { formatLakhCrore } from '@/lib/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const liveTools: { title: MessageKey; question: MessageKey; href: string; icon: 'fuel' | 'sun' }[] =
  [
    {
      title: 'tool.carFuel.title',
      question: 'tool.carFuel.question',
      href: localizePath('/tools/car-fuel/', locale),
      icon: 'fuel',
    },
    {
      title: 'tool.solar.title',
      question: 'tool.solar.question',
      href: localizePath('/tools/solar/', locale),
      icon: 'sun',
    },
  ];
const upcoming: {
  title: MessageKey;
  question: MessageKey;
  icon: 'home' | 'banknote' | 'car' | 'snowflake' | 'percent';
}[] = [
  { title: 'tool.rentVsBuy.title', question: 'tool.rentVsBuy.question', icon: 'home' },
  { title: 'tool.prepay.title', question: 'tool.prepay.question', icon: 'banknote' },
  { title: 'tool.carLoan.title', question: 'tool.carLoan.question', icon: 'car' },
  { title: 'tool.ac.title', question: 'tool.ac.question', icon: 'snowflake' },
  { title: 'tool.taxRegime.title', question: 'tool.taxRegime.question', icon: 'percent' },
];

const principles: { title: MessageKey; body: MessageKey }[] = [
  { title: 'principle.assumptions.title', body: 'principle.assumptions.body' },
  { title: 'principle.conservative.title', body: 'principle.conservative.body' },
  { title: 'principle.realTerms.title', body: 'principle.realTerms.body' },
  { title: 'principle.noProducts.title', body: 'principle.noProducts.body' },
];

// Hero preview: the spec's worked example, computed by the real model so it can never drift.
const example = compareCarFuel(carFuelExample);
const breakeven = example.breakevenWithInterest!;
const months = carFuelExample.horizonMonths;
const W = 320;
const H = 132;
const top =
  Math.max(example.cumulativeSaving[months]!, example.extraPriceWithInterest[months]!) * 1.12;
const x = (m: number) => (m / months) * W;
const y = (v: number) => H - (v / top) * H;
const pt = (series: number[], m: number) => `${x(m).toFixed(2)} ${y(series[m]!).toFixed(2)}`;
const line = (series: number[], from = 0, to = months) =>
  Array.from(
    { length: to - from + 1 },
    (_, i) => `${i === 0 ? 'M' : 'L'}${pt(series, from + i)}`,
  ).join(' ');
const savingPath = line(example.cumulativeSaving);
const costPath = line(example.extraPriceWithInterest);
// The gain after break-even: the band between the saving line (above) and the cost line (below).
const gainArea = `${line(example.cumulativeSaving, breakeven.months)} ${Array.from(
  { length: months - breakeven.months + 1 },
  (_, i) => `L${pt(example.extraPriceWithInterest, months - i)}`,
).join(' ')} Z`;
const beX = x(breakeven.months);
const beY = y(example.cumulativeSaving[breakeven.months]!);
const yearTicks = [0, 2, 4, 6, 8, 10].map((yr) => x(yr * 12));
const nf = new Intl.NumberFormat('en-IN');
const stats = [
  {
    label: t(locale, 'home.preview.breakeven'),
    value: t(locale, 'unit.monthsShort', { n: breakeven.months }),
  },
  {
    label: t(locale, 'home.preview.distance'),
    value: t(locale, 'unit.km', { n: nf.format(breakeven.km) }),
  },
  {
    label: t(locale, 'home.preview.net10'),
    value: formatLakhCrore(example.netAt10Years!.withInterest),
  },
];
---

<BaseLayout locale={locale}>
  <section class="relative overflow-hidden">
    <!-- Two cost lines run behind the glass preview and cross where it sits: the break-even motif. -->
    <svg
      class="pointer-events-none absolute inset-0 hidden h-full w-full text-line-strong lg:block"
      viewBox="0 0 1200 640"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      fill="none"
    >
      <path d="M560 600 L1240 150" stroke="currentColor" stroke-width="1"></path>
      <path
        d="M640 330 L1240 470"
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray="6 8"
      ></path>
    </svg>

    <div class="container-page relative grid items-center gap-8 pt-8 pb-12 sm:pt-12 sm:pb-14 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
      <div class="stagger">
        <h1
          class="max-w-2xl font-display text-display font-medium tracking-(--tracking-display)"
          style="--i: 0"
        >
          {t(locale, 'site.tagline')}
        </h1>
        <p class="mt-4 max-w-lg text-ink-muted sm:text-lg" style="--i: 1">
          {t(locale, 'home.intro')}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-2" style="--i: 2">
          <a href="#tools" class="btn btn-primary">
            {t(locale, 'home.cta')}
            <Icon name="arrowRight" size={18} class="nudge" />
          </a>
          <a href="#principles" class="btn btn-quiet">
            {t(locale, 'home.secondaryCta')}
          </a>
        </div>
      </div>

      <!-- Product preview. Decorative: the same numbers are explained on the tool page. -->
      <figure
        class="glass stagger relative w-full max-w-md justify-self-center rounded-xl p-4 shadow-float sm:p-5 lg:justify-self-end"
        aria-hidden="true"
      >
        <div class="flex items-center justify-between gap-3" style="--i: 2">
          <span class="text-sm font-medium text-ink-muted">{t(locale, 'home.preview.title')}</span>
          <span class="rounded-full bg-surface px-2.5 py-0.5 text-xs font-medium text-ink-muted">
            {t(locale, 'home.preview.label')}
          </span>
        </div>
        <p class="mt-3 font-display text-xl font-semibold" style="--i: 3">
          {t(locale, 'home.preview.verdict', { months: breakeven.months })}
        </p>

        <svg viewBox={`0 0 ${W} ${H + 18}`} class="mt-5 w-full overflow-visible" fill="none">
          <defs>
            <linearGradient id="hero-gain" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0.22"></stop>
              <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0.02"></stop>
            </linearGradient>
          </defs>

          {[0.25, 0.5, 0.75].map((f) => (
            <line
              x1="0"
              x2={W}
              y1={H * f}
              y2={H * f}
              stroke="var(--color-line)"
              stroke-width="0.6"
              stroke-dasharray="1.5 3"
            />
          ))}
          <line
            x1="0"
            x2={W}
            y1={H}
            y2={H}
            stroke="var(--color-line-strong)"
            stroke-width="0.6"
          ></line>
          {yearTicks.map((tx) => (
            <line
              x1={tx}
              x2={tx}
              y1={H}
              y2={H + 3}
              stroke="var(--color-line-strong)"
              stroke-width="0.6"
            />
          ))}

          <path d={gainArea} fill="url(#hero-gain)" class="pop" style="--delay: 900ms"></path>

          <path
            d={costPath}
            pathLength="1"
            class="draw"
            style="--delay: 300ms"
            stroke="var(--color-ink-subtle)"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <path
            d={savingPath}
            pathLength="1"
            class="draw"
            style="--delay: 380ms"
            stroke="var(--color-ink)"
            stroke-width="1.15"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>

          <g class="pop" style="--delay: 1000ms">
            <line
              x1={beX}
              x2={beX}
              y1={beY + 6}
              y2={H}
              stroke="var(--color-accent)"
              stroke-width="0.6"
              stroke-dasharray="1.5 2.5"
            ></line>
            <circle
              cx={beX}
              cy={beY}
              r="6"
              stroke="var(--color-accent)"
              stroke-width="0.6"
            ></circle>
            <circle cx={beX} cy={beY} r="2.4" fill="var(--color-accent)"></circle>
            <text
              x={beX}
              y={beY - 10}
              font-size="8.5"
              font-weight="500"
              fill="var(--color-accent-strong)"
              text-anchor="middle"
              font-family="inherit"
            >
              {t(locale, 'unit.monthsShort', { n: breakeven.months })}
            </text>
          </g>

          <text
            x="0"
            y={H + 14}
            font-size="8.5"
            fill="var(--color-ink-muted)"
            font-family="inherit"
          >
            0
          </text>
          <text
            x={x(60)}
            y={H + 14}
            font-size="8.5"
            fill="var(--color-ink-muted)"
            text-anchor="middle"
            font-family="inherit"
          >
            {t(locale, 'unit.yearsShort', { n: 5 })}
          </text>
          <text
            x={W}
            y={H + 14}
            font-size="8.5"
            fill="var(--color-ink-muted)"
            text-anchor="end"
            font-family="inherit"
          >
            {t(locale, 'unit.yearsShort', { n: months / 12 })}
          </text>
        </svg>

        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted">
          <span class="inline-flex items-center gap-2">
            <span class="h-px w-4 bg-ink"></span>
            {t(locale, 'home.preview.legendSaving')}
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="h-px w-4 bg-ink-subtle"></span>
            {t(locale, 'home.preview.legendCost')}
          </span>
        </div>

        <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-line pt-4">
          {stats.map((s) => (
            <div>
              <dt class="text-xs text-ink-muted">{s.label}</dt>
              <dd class="num mt-1 font-semibold sm:text-lg" data-countup>
                {s.value}
              </dd>
            </div>
          ))}
        </dl>
      </figure>
    </div>
  </section>

  <section id="tools" class="scroll-mt-20 border-t border-line bg-surface">
    <div class="container-page py-10 sm:py-14">
      <h2 class="font-display text-2xl font-medium sm:text-3xl" data-reveal>
        {t(locale, 'home.tools.heading')}
      </h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2" data-reveal>
        {liveTools.map((tool) => (
          <a
            href={tool.href}
            class="card-lift group flex flex-col rounded-xl bg-raised p-5 shadow-raised sm:p-6"
          >
            <span class="inline-flex size-11 items-center justify-center rounded-lg bg-accent-soft text-accent-strong">
              <Icon name={tool.icon} size={24} />
            </span>
            <span class="mt-5 block text-sm font-medium text-ink-muted">
              {t(locale, tool.title)}
            </span>
            <span class="mt-1 block flex-1 font-display text-2xl font-medium text-balance">
              {t(locale, tool.question)}
            </span>
            <span class="mt-5 inline-flex items-center gap-2 self-start font-medium text-accent-strong">
              {t(locale, 'home.tools.status.live')}
              <Icon name="arrowRight" size={18} class="nudge" />
            </span>
          </a>
        ))}
      </div>

      <h3 class="mt-10 text-sm font-medium text-ink-muted" data-reveal>
        {t(locale, 'home.tools.upcomingHeading')}
      </h3>
      <ul
        class="mt-2 grid border-t border-line-strong sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-3"
        role="list"
        data-reveal
      >
        {upcoming.map((tool) => (
          <li class="flex gap-3 border-b border-line py-4">
            <Icon name={tool.icon} size={20} class="mt-0.5 shrink-0 text-ink-muted" />
            <div class="min-w-0">
              <p class="font-medium">{t(locale, tool.title)}</p>
              <p class="mt-0.5 text-sm text-ink-muted">{t(locale, tool.question)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="principles" class="container-page scroll-mt-20 py-10 sm:py-14">
    <h2 class="font-display text-2xl font-medium sm:text-3xl" data-reveal>
      {t(locale, 'home.principles.heading')}
    </h2>
    <ul class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4" role="list" data-reveal>
      {principles.map((p) => (
        <li class="border-t border-line-strong pt-3">
          <h3 class="font-semibold">{t(locale, p.title)}</h3>
          <p class="mt-2 max-w-(--container-prose) text-sm text-ink-muted">{t(locale, p.body)}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
