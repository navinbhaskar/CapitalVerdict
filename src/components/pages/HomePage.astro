---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { compareCarFuel } from '@/models/carFuel';
import { carFuelExample } from '@/models/carFuel.example';
import { formatLakhCrore } from '@/lib/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const liveTool = {
  title: 'tool.carFuel.title' as MessageKey,
  question: 'tool.carFuel.question' as MessageKey,
  href: localizePath('/tools/car-fuel/', locale),
};
const upcoming: { title: MessageKey; question: MessageKey; icon: 'home' | 'sun' }[] = [
  { title: 'tool.rentVsBuy.title', question: 'tool.rentVsBuy.question', icon: 'home' },
  { title: 'tool.solar.title', question: 'tool.solar.question', icon: 'sun' },
];

const principles: { title: MessageKey; body: MessageKey }[] = [
  { title: 'principle.assumptions.title', body: 'principle.assumptions.body' },
  { title: 'principle.conservative.title', body: 'principle.conservative.body' },
  { title: 'principle.realTerms.title', body: 'principle.realTerms.body' },
  { title: 'principle.noProducts.title', body: 'principle.noProducts.body' },
];

// Hero preview: the spec's worked example, computed by the real model so it can never drift.
const example = compareCarFuel(carFuelExample);
const breakeven = example.breakevenWithInterest!;
const months = carFuelExample.horizonMonths;
const W = 320;
const H = 132;
const top =
  Math.max(example.cumulativeSaving[months]!, example.extraPriceWithInterest[months]!) * 1.08;
const x = (m: number) => (m / months) * W;
const y = (v: number) => H - (v / top) * H;
const line = (series: number[]) =>
  series
    .filter((_, m) => m % 2 === 0 || m === months)
    .map((v, i, arr) => {
      const m = i === arr.length - 1 ? months : i * 2;
      return `${i === 0 ? 'M' : 'L'}${x(m).toFixed(1)} ${y(v).toFixed(1)}`;
    })
    .join(' ');
const savingPath = line(example.cumulativeSaving);
const costPath = line(example.extraPriceWithInterest);
const savingArea = `${savingPath} L${W} ${H} L0 ${H} Z`;
const beX = x(breakeven.months);
const beY = y(example.cumulativeSaving[breakeven.months]!);
const nf = new Intl.NumberFormat('en-IN');
const stats = [
  {
    label: t(locale, 'home.preview.breakeven'),
    value: t(locale, 'unit.monthsShort', { n: breakeven.months }),
  },
  {
    label: t(locale, 'home.preview.distance'),
    value: t(locale, 'unit.km', { n: nf.format(breakeven.km) }),
  },
  {
    label: t(locale, 'home.preview.net10'),
    value: formatLakhCrore(example.netAt10Years!.withInterest),
  },
];
---

<BaseLayout locale={locale}>
  <section class="relative overflow-hidden">
    <!-- Two cost lines run behind the glass preview and cross where it sits: the break-even motif. -->
    <svg
      class="pointer-events-none absolute inset-0 hidden h-full w-full text-line-strong lg:block"
      viewBox="0 0 1200 640"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      fill="none"
    >
      <path d="M560 600 L1240 150" stroke="currentColor" stroke-width="1.5"></path>
      <path
        d="M640 330 L1240 470"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-dasharray="6 8"
      ></path>
    </svg>

    <div class="container-page relative grid items-center gap-8 pt-8 pb-12 sm:pt-12 sm:pb-14 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
      <div class="stagger">
        <h1
          class="max-w-2xl font-display text-display font-semibold tracking-(--tracking-display)"
          style="--i: 0"
        >
          {t(locale, 'site.tagline')}
        </h1>
        <p class="mt-4 max-w-lg text-ink-muted sm:text-lg" style="--i: 1">
          {t(locale, 'home.intro')}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-2" style="--i: 2">
          <a href="#tools" class="btn btn-primary">
            {t(locale, 'home.cta')}
            <Icon name="arrowRight" size={18} class="nudge" />
          </a>
          <a href="#principles" class="btn btn-quiet">
            {t(locale, 'home.secondaryCta')}
          </a>
        </div>
      </div>

      <!-- Product preview. Decorative: the same numbers are explained on the tool page. -->
      <figure
        class="glass stagger relative w-full max-w-md justify-self-center rounded-xl p-4 shadow-float sm:p-5 lg:justify-self-end"
        aria-hidden="true"
      >
        <div class="flex items-center justify-between gap-3" style="--i: 2">
          <span class="text-sm font-medium text-ink-muted">{t(locale, 'home.preview.title')}</span>
          <span class="rounded-full bg-surface px-2.5 py-0.5 text-xs font-medium text-ink-muted">
            {t(locale, 'home.preview.label')}
          </span>
        </div>
        <p class="mt-3 font-display text-xl font-semibold" style="--i: 3">
          {t(locale, 'home.preview.verdict', { months: breakeven.months })}
        </p>

        <svg viewBox={`0 0 ${W} ${H + 18}`} class="mt-5 w-full overflow-visible" fill="none">
          {[0.25, 0.5, 0.75].map((f) => (
            <line x1="0" x2={W} y1={H * f} y2={H * f} stroke="var(--color-line)" />
          ))}
          <line x1="0" x2={W} y1={H} y2={H} stroke="var(--color-line-strong)"></line>
          <path
            d={savingArea}
            fill="var(--color-accent)"
            fill-opacity="0.08"
            class="pop"
            style="--delay: 700ms"
          ></path>
          <path
            d={costPath}
            pathLength="1"
            class="draw"
            style="--delay: 300ms"
            stroke="var(--color-ink-subtle)"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
          <path
            d={savingPath}
            pathLength="1"
            class="draw"
            style="--delay: 380ms"
            stroke="var(--color-ink)"
            stroke-width="2.25"
            stroke-linecap="round"
          ></path>
          <g class="pop" style="--delay: 900ms">
            <line
              x1={beX}
              x2={beX}
              y1={beY}
              y2={H}
              stroke="var(--color-accent)"
              stroke-width="1.5"
              stroke-dasharray="2 4"
            ></line>
            <circle
              cx={beX}
              cy={beY}
              r="11"
              fill="var(--color-accent)"
              fill-opacity="0.15"
            ></circle>
            <circle cx={beX} cy={beY} r="5" fill="var(--color-accent)"></circle>
          </g>
          <text x="0" y={H + 15} font-size="11" fill="var(--color-ink-muted)" font-family="inherit">
            0
          </text>
          <text
            x={W}
            y={H + 15}
            font-size="11"
            fill="var(--color-ink-muted)"
            text-anchor="end"
            font-family="inherit"
          >
            {t(locale, 'unit.yearsShort', { n: months / 12 })}
          </text>
        </svg>

        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-muted">
          <span class="inline-flex items-center gap-2">
            <span class="h-0.5 w-4 rounded-full bg-ink"></span>
            {t(locale, 'home.preview.legendSaving')}
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="w-4 border-t-2 border-ink-subtle"></span>
            {t(locale, 'home.preview.legendCost')}
          </span>
        </div>

        <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-line pt-4">
          {stats.map((s) => (
            <div>
              <dt class="text-xs text-ink-muted">{s.label}</dt>
              <dd class="num mt-1 font-semibold sm:text-lg" data-countup>
                {s.value}
              </dd>
            </div>
          ))}
        </dl>
      </figure>
    </div>
  </section>

  <section id="tools" class="scroll-mt-20 border-t border-line bg-surface">
    <div class="container-page py-10 sm:py-14">
      <h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>
        {t(locale, 'home.tools.heading')}
      </h2>
      <div class="mt-6 grid gap-4 lg:grid-cols-3" data-reveal>
        <a
          href={liveTool.href}
          class="card-lift group flex flex-col rounded-xl bg-raised p-5 shadow-raised sm:p-6 lg:col-span-2"
        >
          <span class="inline-flex size-10 items-center justify-center rounded-lg bg-accent-soft text-accent-strong">
            <Icon name="fuel" size={24} />
          </span>
          <span class="mt-5 text-sm font-medium text-ink-muted">{t(locale, liveTool.title)}</span>
          <span class="mt-1 font-display text-2xl font-semibold text-balance sm:text-3xl">
            {t(locale, liveTool.question)}
          </span>
          <span class="mt-5 inline-flex items-center gap-2 self-start font-medium text-accent-strong">
            {t(locale, 'home.tools.status.live')}
            <Icon name="arrowRight" size={18} class="nudge" />
          </span>
        </a>

        <ul class="grid gap-5" role="list">
          {upcoming.map((tool) => (
            <li class="flex h-full flex-col rounded-xl border border-dashed border-line-strong p-4">
              <div class="flex items-center justify-between gap-3">
                <Icon name={tool.icon} size={22} class="text-ink-muted" />
                <span class="text-sm text-ink-muted">{t(locale, 'home.tools.status.soon')}</span>
              </div>
              <h3 class="mt-3 font-semibold">{t(locale, tool.title)}</h3>
              <p class="mt-1 text-sm text-ink-muted">{t(locale, tool.question)}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="principles" class="container-page scroll-mt-20 py-10 sm:py-14">
    <h2 class="font-display text-2xl font-semibold sm:text-3xl" data-reveal>
      {t(locale, 'home.principles.heading')}
    </h2>
    <ul class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4" role="list" data-reveal>
      {principles.map((p) => (
        <li class="border-t border-line-strong pt-3">
          <h3 class="font-semibold">{t(locale, p.title)}</h3>
          <p class="mt-2 max-w-(--container-prose) text-sm text-ink-muted">{t(locale, p.body)}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
