---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import HeroDecider from '@/components/islands/HeroDecider';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { getCollection } from 'astro:content';
import { byDateDesc } from '@/lib/blog';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const liveTools: {
  title: MessageKey;
  question: MessageKey;
  href: string;
  icon: 'fuel' | 'sun' | 'home';
}[] = [
  {
    title: 'tool.carFuel.title',
    question: 'tool.carFuel.question',
    href: localizePath('/tools/car-fuel/', locale),
    icon: 'fuel',
  },
  {
    title: 'tool.solar.title',
    question: 'tool.solar.question',
    href: localizePath('/tools/solar/', locale),
    icon: 'sun',
  },
  {
    title: 'tool.rentVsBuy.title',
    question: 'tool.rentVsBuy.question',
    href: localizePath('/tools/rent-vs-buy/', locale),
    icon: 'home',
  },
];
const upcoming: {
  title: MessageKey;
  question: MessageKey;
  icon: 'banknote' | 'car' | 'snowflake' | 'percent';
}[] = [
  { title: 'tool.prepay.title', question: 'tool.prepay.question', icon: 'banknote' },
  { title: 'tool.carLoan.title', question: 'tool.carLoan.question', icon: 'car' },
  { title: 'tool.ac.title', question: 'tool.ac.question', icon: 'snowflake' },
  { title: 'tool.taxRegime.title', question: 'tool.taxRegime.question', icon: 'percent' },
];

const notes = (await getCollection('blog')).sort(byDateDesc).slice(0, 3);

const principles: { title: MessageKey; body: MessageKey }[] = [
  { title: 'principle.assumptions.title', body: 'principle.assumptions.body' },
  { title: 'principle.conservative.title', body: 'principle.conservative.body' },
  { title: 'principle.realTerms.title', body: 'principle.realTerms.body' },
  { title: 'principle.noProducts.title', body: 'principle.noProducts.body' },
];
---

<BaseLayout
  locale={locale}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: t(locale, 'site.name'),
      url: new URL('/', Astro.site).href,
      description: t(locale, 'site.description'),
      inLanguage: 'en-IN',
    },
  ]}
>
  <section class="band-dark relative overflow-hidden">
    <!-- Two cost lines run behind the live example and cross where it sits: the break-even motif. -->
    <svg
      class="pointer-events-none absolute inset-0 hidden h-full w-full text-line-strong lg:block"
      viewBox="0 0 1200 640"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      fill="none"
    >
      <path d="M560 600 L1240 150" stroke="currentColor" stroke-width="1"></path>
      <path
        d="M640 330 L1240 470"
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray="6 8"
      ></path>
    </svg>

    <div class="container-page relative grid items-center gap-10 pt-10 pb-16 sm:pt-16 sm:pb-20 lg:grid-cols-[1.35fr_1fr] lg:gap-14 lg:pt-20 lg:pb-28">
      <div class="stagger">
        <span class="rule-brass" style="--i: 0" aria-hidden="true"></span>
        <h1
          class="mt-6 max-w-2xl font-display text-display font-medium tracking-(--tracking-display)"
          style="--i: 0"
        >
          {t(locale, 'site.tagline')}
        </h1>
        <p class="mt-6 max-w-lg text-lg text-ink-muted" style="--i: 1">
          {t(locale, 'home.intro')}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3" style="--i: 2">
          <a href="#tools" class="btn btn-primary">
            {t(locale, 'home.cta')}
            <Icon name="arrowRight" size={18} class="nudge" />
          </a>
          <a href="#principles" class="btn btn-quiet">
            {t(locale, 'home.secondaryCta')}
          </a>
        </div>
      </div>

      <!-- Live example: the real model with verified prices and the visitor's own distance. -->
      <div class="stagger flex">
        <HeroDecider client:load locale={locale} />
      </div>
    </div>
  </section>

  <section id="tools" class="scroll-mt-20">
    <div class="container-page py-14 sm:py-20">
      <div data-reveal>
        <span class="rule-brass" aria-hidden="true"></span>
        <h2 class="mt-5 font-display text-3xl font-medium tracking-(--tracking-display) sm:text-4xl">
          {t(locale, 'home.tools.heading')}
        </h2>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3" data-reveal>
        {liveTools.map((tool) => (
          <a
            href={tool.href}
            class="card-lift group flex flex-col rounded-xl border border-line bg-raised p-6 transition-colors duration-(--duration-base) ease-out-quart hover:border-accent sm:p-7"
          >
            <span class="band-dark inline-flex size-12 items-center justify-center rounded-full text-accent">
              <Icon name={tool.icon} size={22} />
            </span>
            <span class="mt-6 block text-sm font-medium text-ink-muted">
              {t(locale, tool.title)}
            </span>
            <span class="mt-2 block flex-1 font-display text-2xl font-medium tracking-(--tracking-heading) text-balance">
              {t(locale, tool.question)}
            </span>
            <span class="mt-6 inline-flex items-center gap-2 self-start border-b border-accent pb-0.5 font-medium text-accent-strong">
              {t(locale, 'home.tools.status.live')}
              <Icon name="arrowRight" size={18} class="nudge" />
            </span>
          </a>
        ))}
      </div>

      <h3 class="mt-14 text-sm font-medium text-ink-muted" data-reveal>
        {t(locale, 'home.tools.upcomingHeading')}
      </h3>
      <ul
        class="mt-3 grid border-t border-line-strong sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-4"
        role="list"
        data-reveal
      >
        {upcoming.map((tool) => (
          <li class="flex gap-3 border-b border-line py-4">
            <Icon name={tool.icon} size={20} class="mt-0.5 shrink-0 text-accent-strong" />
            <div class="min-w-0">
              <p class="font-medium">{t(locale, tool.title)}</p>
              <p class="mt-0.5 text-sm text-ink-muted">{t(locale, tool.question)}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="principles" class="band-dark scroll-mt-20">
    <div class="container-page py-14 sm:py-20">
      <div data-reveal>
        <span class="rule-brass" aria-hidden="true"></span>
        <h2 class="mt-5 font-display text-3xl font-medium tracking-(--tracking-display) sm:text-4xl">
          {t(locale, 'home.principles.heading')}
        </h2>
      </div>
      <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4" role="list" data-reveal>
        {principles.map((p) => (
          <li class="border-t border-line-strong pt-5">
            <h3 class="font-display text-xl font-medium">{t(locale, p.title)}</h3>
            <p class="mt-3 max-w-(--container-prose) text-ink-muted">{t(locale, p.body)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {notes.length > 0 && (
    <section class="container-page py-14 sm:py-20" aria-labelledby="home-notes">
      <div class="flex flex-wrap items-end justify-between gap-3" data-reveal>
        <div>
          <span class="rule-brass" aria-hidden="true"></span>
          <h2
            id="home-notes"
            class="mt-5 font-display text-3xl font-medium tracking-(--tracking-display) sm:text-4xl"
          >
            {t(locale, 'home.notes.heading')}
          </h2>
        </div>
        <a href={localizePath('/blog/', locale)} class="link">
          {t(locale, 'home.notes.all')}
        </a>
      </div>
      <ul class="mt-8 grid gap-x-10 sm:grid-cols-3" role="list" data-reveal>
        {notes.map((post) => (
          <li class="border-t border-line-strong">
            <a href={`/blog/${post.id}/`} class="group block py-5">
              <span class="block font-display text-xl font-medium tracking-(--tracking-heading) group-hover:text-accent-strong">
                {post.data.title}
              </span>
              <span class="mt-2 block text-ink-muted">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
