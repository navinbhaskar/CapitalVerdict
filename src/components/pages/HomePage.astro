---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import HeroDecider from '@/components/islands/HeroDecider';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { getCollection } from 'astro:content';
import { byDateDesc } from '@/lib/blog';
import { TOOL_GROUPS, toolKey, type ToolIcon } from '@/lib/tools';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

interface Tool {
  /** Short name, e.g. "EMI calculator". The full question heads the tool's own page. */
  title: MessageKey;
  /** What the answer tells you, in one line. */
  gives: MessageKey;
  href: string;
  icon: ToolIcon;
}
/** The calculators by area of life, so a visitor finds theirs at a glance. */
const toolGroups: { title: MessageKey; tools: Tool[] }[] = TOOL_GROUPS.map((group) => ({
  title: group.title,
  tools: group.tools.map((entry) => ({
    title: toolKey(entry, 'title'),
    gives: toolKey(entry, 'gives'),
    href: localizePath(entry.path, locale),
    icon: entry.icon,
  })),
}));
const notes = (await getCollection('blog')).sort(byDateDesc).slice(0, 3);

const principles: { title: MessageKey; body: MessageKey }[] = [
  { title: 'principle.assumptions.title', body: 'principle.assumptions.body' },
  { title: 'principle.conservative.title', body: 'principle.conservative.body' },
  { title: 'principle.realTerms.title', body: 'principle.realTerms.body' },
  { title: 'principle.noProducts.title', body: 'principle.noProducts.body' },
];
---

<BaseLayout
  locale={locale}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: t(locale, 'site.name'),
      url: new URL('/', Astro.site).href,
      description: t(locale, 'site.description'),
      inLanguage: 'en-IN',
    },
  ]}
>
  <section class="band-dark relative overflow-hidden">
    <!-- Two cost lines run behind the live example and cross where it sits: the break-even motif. -->
    <svg
      class="pointer-events-none absolute inset-0 hidden h-full w-full text-line-strong lg:block"
      viewBox="0 0 1200 640"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      fill="none"
    >
      <path d="M560 600 L1240 150" stroke="currentColor" stroke-width="1"></path>
      <path
        d="M640 330 L1240 470"
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray="6 8"
      ></path>
    </svg>

    <div class="container-page relative grid items-center gap-6 pt-6 pb-10 sm:pt-8 sm:pb-12 lg:grid-cols-[1.35fr_1fr] lg:gap-12 lg:pt-8 lg:pb-12">
      <div class="stagger">
        <span class="rule-brass" style="--i: 0" aria-hidden="true"></span>
        <h1
          class="mt-4 max-w-2xl font-display text-display font-medium tracking-(--tracking-display)"
          style="--i: 0"
        >
          {t(locale, 'site.tagline')}
        </h1>
        <p class="mt-4 max-w-md text-ink-muted" style="--i: 1">
          {t(locale, 'home.intro')}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3" style="--i: 2">
          <a href="#tools" class="btn btn-primary">
            {t(locale, 'home.cta')}
            <Icon name="arrowRight" size={18} class="nudge" />
          </a>
          <a href="#principles" class="btn btn-quiet">
            {t(locale, 'home.secondaryCta')}
          </a>
        </div>
      </div>

      <!-- Live example: the real model with verified prices and the visitor's own distance. -->
      <div class="stagger flex">
        <HeroDecider client:load locale={locale} />
      </div>
    </div>
  </section>

  <section id="tools" class="scroll-mt-20">
    <div class="container-page py-10 sm:py-12">
      <div data-reveal>
        <span class="rule-brass" aria-hidden="true"></span>
        <h2 class="mt-3 font-display text-2xl font-medium tracking-(--tracking-display)">
          {t(locale, 'home.tools.heading')}
        </h2>
      </div>
      <!-- One row per area of life: its name, then its calculators in an even grid. -->
      <div class="mt-5 divide-y divide-line border-y border-line" data-reveal>
        {toolGroups.map((group) => (
          <section class="py-5" aria-label={t(locale, group.title)}>
            <h3 class="font-display text-xl font-medium tracking-(--tracking-heading)">
              {t(locale, group.title)}
            </h3>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list">
              {group.tools.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="card-lift group flex h-full items-start gap-3 rounded-xl border border-line bg-raised px-4 py-3.5 transition-colors duration-(--duration-base) ease-out-quart hover:border-accent"
                  >
                    <span class="band-dark mt-0.5 inline-flex size-9 shrink-0 items-center justify-center rounded-full text-accent">
                      <Icon name={item.icon} size={18} />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-baseline justify-between gap-2">
                        <span class="font-display text-lg leading-snug font-medium tracking-(--tracking-heading) group-hover:text-accent-strong">
                          {t(locale, item.title)}
                        </span>
                        <Icon
                          name="arrowRight"
                          size={18}
                          class="nudge shrink-0 self-center text-accent-strong"
                        />
                      </span>
                      <span class="mt-1 block text-sm text-ink-muted">{t(locale, item.gives)}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section id="principles" class="band-dark scroll-mt-20">
    <div class="container-page py-10 sm:py-12">
      <div data-reveal>
        <span class="rule-brass" aria-hidden="true"></span>
        <h2 class="mt-3 font-display text-2xl font-medium tracking-(--tracking-display)">
          {t(locale, 'home.principles.heading')}
        </h2>
      </div>
      <ul class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4" role="list" data-reveal>
        {principles.map((p) => (
          <li class="border-t border-line-strong pt-4">
            <h3 class="font-display text-xl font-medium">{t(locale, p.title)}</h3>
            <p class="mt-2 max-w-(--container-prose) text-sm text-ink-muted">{t(locale, p.body)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {notes.length > 0 && (
    <section class="container-page py-10 sm:py-12" aria-labelledby="home-notes">
      <div class="flex flex-wrap items-end justify-between gap-3" data-reveal>
        <div>
          <span class="rule-brass" aria-hidden="true"></span>
          <h2
            id="home-notes"
            class="mt-3 font-display text-2xl font-medium tracking-(--tracking-display)"
          >
            {t(locale, 'home.notes.heading')}
          </h2>
        </div>
        <a href={localizePath('/guides/', locale)} class="link">
          {t(locale, 'home.notes.all')}
        </a>
      </div>
      <ul class="mt-5 grid gap-x-8 sm:grid-cols-3" role="list" data-reveal>
        {notes.map((post) => (
          <li class="border-t border-line-strong">
            <a href={`/guides/${post.id}/`} class="group block py-4">
              <span class="block font-display text-xl font-medium tracking-(--tracking-heading) group-hover:text-accent-strong">
                {post.data.title}
              </span>
              <span class="mt-1 block text-sm text-ink-muted">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
