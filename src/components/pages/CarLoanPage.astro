---
import ToolLayout from '@/layouts/ToolLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import AssumptionsTable, { type AssumptionRow } from '@/components/tool/AssumptionsTable.astro';
import CarLoanTool from '@/components/islands/CarLoanTool';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { defaults } from '@/data';
import { formatPercent } from '@/lib/formatTool';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const loan = defaults.globalAssumptions.carLoanRate;
const inflation = defaults.scenarioVariables.inflation;
const rows: AssumptionRow[] = [
  {
    label: t(locale, 'carLoan.in.loanRate'),
    value: loan.value === null ? '—' : formatPercent(loan.value),
    source: loan.source,
    date: loan.effectiveDate,
    verified: loan.status === 'verified',
  },
  {
    label: t(locale, 'carLoan.in.inflation'),
    value: formatPercent(inflation.values.base),
    source: inflation.source,
    date: inflation.effectiveDate,
    verified: inflation.status === 'verified',
  },
];

const FAQ = [1, 2, 3] as const;
const related = [
  { href: localizePath('/tools/car-fuel/', locale), label: t(locale, 'tool.carFuel.title') },
  { href: localizePath('/tools/prepay-or-invest/', locale), label: t(locale, 'tool.prepay.title') },
];
---

<ToolLayout
  locale={locale}
  title={t(locale, 'tool.carLoan.question')}
  description={t(locale, 'carLoan.metaDescription')}
  related={related}
  faq={FAQ.map((n) => ({
    q: t(locale, `carLoan.faq.${n}.q` as MessageKey),
    a: t(locale, `carLoan.faq.${n}.a` as MessageKey),
  }))}
>
  <CarLoanTool client:load locale={locale} />

  <p slot="explanation">{t(locale, 'carLoan.explanation')}</p>

  <AssumptionsTable slot="assumptions" locale={locale} rows={rows} />

  <div slot="faq" class="divide-y divide-line border-y border-line">
    {FAQ.map((n) => (
      <details class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2.5 font-medium text-ink">
          {t(locale, `carLoan.faq.${n}.q` as MessageKey)}
          <Icon
            name="chevronDown"
            size={18}
            class="shrink-0 text-ink-muted transition-transform duration-(--duration-base) ease-out-quart group-open:rotate-180"
          />
        </summary>
        <p class="max-w-(--container-prose) pb-3 text-sm">
          {t(locale, `carLoan.faq.${n}.a` as MessageKey)}
        </p>
      </details>
    ))}
  </div>
</ToolLayout>
