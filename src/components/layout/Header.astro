---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { TOOL_GROUPS, toolKey } from '@/lib/tools';
import AssumptionsPanel from '@/components/islands/AssumptionsPanel';
import { t, type Locale } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';

interface Props {
  locale: Locale;
  /** Locale-neutral path of the current page, for the active link. */
  path: string;
}
const { locale, path } = Astro.props;
const home = localizePath('/', locale);
const onTool = path.startsWith('/tools/');
const methodology = localizePath('/methodology/', locale);
const onMethodology = path.startsWith('/methodology');
const blog = localizePath('/guides/', locale);
const onBlog = path.startsWith('/guides');
---

<!--
  A solid forest bar (a dark band) that stays at the top; once the page scrolls it gains a hairline
  and a soft shadow (html[data-scrolled], set in Motion.astro).
-->
<header class="site-header band-dark print:hidden sticky top-0 z-40 isolate">
  <div class="container-page">
    <div class="nav-bar flex h-16 items-center justify-between gap-2">
      <a href={home} aria-label={t(locale, 'a11y.home')} class="shrink-0 rounded-sm py-1">
        <Logo intro />
      </a>
      <nav aria-label={t(locale, 'nav.primary')}>
        <ul class="flex items-center gap-0.5">
          <li class="sm:relative" data-tools-menu>
            <button
              type="button"
              class="nav-link group gap-1"
              aria-expanded="false"
              aria-controls="tools-menu"
              data-current={onTool ? '' : undefined}
            >
              {t(locale, 'nav.calculators')}
              <svg
                class="size-4 transition-transform duration-(--duration-fast) ease-out-quart group-aria-expanded:rotate-180"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M4 6l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <div
              id="tools-menu"
              hidden
              class="tools-menu fixed inset-x-4 top-18 max-h-[calc(100dvh-5.5rem)] overflow-y-auto rounded-xl bg-raised p-2 shadow-float sm:absolute sm:inset-x-auto sm:top-full sm:right-0 sm:mt-1 sm:w-xl sm:p-3"
            >
              <div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
                {TOOL_GROUPS.map((group) => (
                  <section aria-label={t(locale, group.title)}>
                    <p class="px-2 pt-1 text-sm text-ink-muted">{t(locale, group.title)}</p>
                    <ul class="mt-1" role="list">
                      {group.tools.map((entry) => {
                        const href = localizePath(entry.path, locale);
                        const current = path.startsWith(entry.path);
                        return (
                          <li>
                            <a
                              href={href}
                              aria-current={current ? 'page' : undefined}
                              class="flex min-h-11 items-center gap-3 rounded-lg px-2 py-1.5 text-sm font-medium transition-colors duration-(--duration-fast) ease-out-quart hover:bg-surface hover:text-accent-strong aria-[current=page]:text-accent-strong"
                            >
                              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-line text-accent">
                                <Icon name={entry.icon} size={16} />
                              </span>
                              {t(locale, toolKey(entry, 'title'))}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </section>
                ))}
              </div>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 border-t border-line px-2 pt-2 text-sm">
                <a href={`${home}#tools`} class="link inline-flex min-h-11 items-center">
                  {t(locale, 'nav.allCalculators')}
                </a>
                <a href={blog} class="link inline-flex min-h-11 items-center sm:hidden">
                  {t(locale, 'nav.blog')}
                </a>
              </div>
            </div>
          </li>
          <li class="hidden sm:block">
            <a href={blog} class="nav-link" aria-current={onBlog ? 'page' : undefined}>
              {t(locale, 'nav.blog')}
            </a>
          </li>
          <li class="hidden md:block">
            <a
              href={methodology}
              class="nav-link"
              aria-current={onMethodology ? 'page' : undefined}
            >
              {t(locale, 'nav.principles')}
            </a>
          </li>
          <li class="ml-1 sm:ml-2">
            <AssumptionsPanel client:idle locale={locale} />
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  // The Calculators menu: a disclosure. Opens on click, closes on Escape, an outside click or when
  // focus leaves it.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tools-menu]')) {
    const button = root.querySelector('button')!;
    const panel = root.querySelector<HTMLElement>('.tools-menu')!;
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        set(false);
        button.focus();
      }
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) set(false);
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) set(false);
    });
  }
</script>
