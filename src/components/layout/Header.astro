---
import Logo from './Logo.astro';
import { t, type Locale } from '@/i18n/t';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const home = locale === 'en' ? '/' : `/${locale}/`;
---

<header class="border-b border-line bg-page/90 backdrop-blur supports-[backdrop-filter]:bg-page/80">
  <div class="container-page flex h-16 items-center justify-between">
    <a href={home} aria-label={t(locale, 'a11y.home')} class="-mx-1 rounded px-1 py-1">
      <Logo />
    </a>
    <nav aria-label={t(locale, 'nav.primary')}>
      <ul class="flex items-center gap-1 text-[0.9375rem] text-ink-muted">
        <li>
          <a
            href={`${home}#tools`}
            class="inline-flex min-h-11 items-center rounded-md px-3 transition-colors duration-200 hover:bg-surface hover:text-ink"
          >
            {t(locale, 'nav.tools')}
          </a>
        </li>
        <li>
          <a
            href={`${home}#principles`}
            class="inline-flex min-h-11 items-center rounded-md px-3 transition-colors duration-200 hover:bg-surface hover:text-ink"
          >
            {t(locale, 'nav.principles')}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
