---
import Logo from './Logo.astro';
import AssumptionsPanel from '@/components/islands/AssumptionsPanel';
import { t, type Locale } from '@/i18n/t';
import { localizePath, otherLocale } from '@/i18n/routes';

interface Props {
  locale: Locale;
  /** Locale-neutral path of the current page, for the language switch. */
  path: string;
}
const { locale, path } = Astro.props;
const home = localizePath('/', locale);
const switchTo = otherLocale(locale);
const linkClass =
  'inline-flex min-h-11 items-center rounded-md px-3 transition-colors duration-(--duration-fast) ease-out-quart hover:bg-surface hover:text-ink';
---

<header class="glass sticky top-0 z-40 border-b border-line">
  <div class="container-page flex h-14 items-center justify-between gap-2">
    <a href={home} aria-label={t(locale, 'a11y.home')} class="-mx-1 shrink-0 rounded-sm px-1 py-1">
      <Logo intro />
    </a>
    <nav aria-label={t(locale, 'nav.primary')}>
      <ul class="flex items-center text-sm text-ink-muted sm:text-base">
        <li>
          <a href={`${home}#tools`} class={linkClass}>
            {t(locale, 'nav.tools')}
          </a>
        </li>
        <li class="hidden md:block">
          <a href={`${home}#principles`} class={linkClass}>
            {t(locale, 'nav.principles')}
          </a>
        </li>
        <li>
          <a
            href={localizePath(path, switchTo)}
            hreflang={switchTo}
            lang={switchTo}
            class={linkClass}
          >
            {t(locale, 'nav.switchLanguage')}
          </a>
        </li>
        <li>
          <AssumptionsPanel client:idle locale={locale} />
        </li>
      </ul>
    </nav>
  </div>
</header>
