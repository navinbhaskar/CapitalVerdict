---
import Logo from './Logo.astro';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
const links: [MessageKey, string][] = [
  ['footer.link.blog', '/blog/'],
  ['footer.link.methodology', '/methodology/'],
  ['footer.link.changelog', '/assumptions-changelog/'],
  ['footer.link.about', '/about/'],
  ['footer.link.disclaimer', '/disclaimer/'],
  ['footer.link.terms', '/terms/'],
  ['footer.link.privacy', '/privacy/'],
  ['footer.link.trademarks', '/trademarks/'],
];
---

<footer class="band-dark print:hidden">
  <div class="container-page flex flex-col gap-5 py-8 text-sm text-ink-muted sm:flex-row sm:items-start sm:justify-between sm:py-10">
    <div class="flex flex-col gap-3">
      <Logo size={24} />
      <p class="max-w-sm font-display text-xl font-medium tracking-(--tracking-heading) text-ink">
        {t(locale, 'site.tagline')}
      </p>
      <span class="rule-brass" aria-hidden="true"></span>
      <p class="max-w-md">{t(locale, 'footer.disclaimer')}</p>
      <nav aria-label={t(locale, 'footer.nav')}>
        <ul class="-mx-1 flex max-w-md flex-wrap gap-x-1" role="list">
          {links.map(([label, path]) => (
            <li>
              <a
                href={localizePath(path, locale)}
                class="inline-flex min-h-11 items-center rounded-sm px-1 underline decoration-line-strong decoration-1 underline-offset-4 hover:text-ink hover:decoration-current"
              >
                {t(locale, label)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="flex flex-col gap-2 sm:items-end">
      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        class="-mx-2 inline-flex min-h-11 items-center gap-2 rounded-md px-2 hover:bg-surface hover:text-ink"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linejoin="round"
          ></path>
        </svg>
        {t(locale, 'theme.dark')}
      </button>
      <p class="num">{t(locale, 'footer.copyright', { year })}</p>
    </div>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', dark ? '#12302a' : '#0f2a22');
    try {
      localStorage.setItem('dw.theme', dark ? 'dark' : 'light');
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    sync();
  });
</script>
