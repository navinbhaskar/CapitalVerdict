---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { t, type Locale, type MessageKey } from '@/i18n/t';
import { localizePath } from '@/i18n/routes';
import { TOOL_GROUPS, toolKey } from '@/lib/tools';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
const learn: [MessageKey, string][] = [
  ['footer.link.blog', '/guides/'],
  ['nav.principles', '/methodology/'],
  ['footer.link.changelog', '/assumptions-changelog/'],
  ['footer.link.about', '/about/'],
];
const legal: [MessageKey, string][] = [
  ['footer.link.disclaimer', '/disclaimer/'],
  ['footer.link.terms', '/terms/'],
  ['footer.link.privacy', '/privacy/'],
  ['footer.link.trademarks', '/trademarks/'],
];
/** What every tool promises, from the methodology page. */
const promises: MessageKey[] = [
  'principle.assumptions.title',
  'principle.conservative.title',
  'principle.realTerms.title',
  'principle.noProducts.title',
];
// 44px tap targets on touch screens, a tighter list on wider ones.
const linkClass =
  'inline-flex min-h-11 items-center rounded-sm hover:text-ink sm:min-h-0 sm:py-1 transition-colors duration-(--duration-fast) ease-out-quart';
---

<footer class="band-dark print:hidden">
  <div class="container-page py-8 text-sm text-ink-muted sm:py-10">
    <span class="rule-brass" aria-hidden="true"></span>
    <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,16rem)_minmax(0,1fr)_auto] lg:gap-x-12">
      <div>
        <Logo />
        <p class="mt-2 max-w-xs">{t(locale, 'site.tagline')}</p>
        <ul class="mt-4 hidden space-y-1.5 sm:block" role="list">
          {promises.map((key) => (
            <li class="flex items-center gap-2">
              <Icon name="check" size={14} class="shrink-0 text-accent" />
              {t(locale, key)}
            </li>
          ))}
        </ul>
        <button
          type="button"
          data-theme-toggle
          aria-pressed="false"
          class="-mx-1.5 mt-4 inline-flex min-h-11 items-center gap-1.5 rounded-md px-1.5 hover:bg-surface hover:text-ink sm:min-h-8"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linejoin="round"
            ></path>
          </svg>
          {t(locale, 'theme.dark')}
        </button>
      </div>

      <nav aria-label={t(locale, 'footer.nav')} class="contents">
        <div>
          <h2 class="font-medium text-ink">{t(locale, 'footer.group.tools')}</h2>
          <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-4 md:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
            {TOOL_GROUPS.map((group) => (
              <div>
                <h3 class="text-ink-subtle">{t(locale, group.title)}</h3>
                <ul class="mt-1 sm:space-y-0.5" role="list">
                  {group.tools.map((entry) => (
                    <li>
                      <a href={localizePath(entry.path, locale)} class={linkClass}>
                        {t(locale, toolKey(entry, 'title'))}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="font-medium text-ink">{t(locale, 'footer.group.learn')}</h2>
          <ul class="mt-3 sm:space-y-0.5" role="list">
            {learn.map(([label, path]) => (
              <li>
                <a href={localizePath(path, locale)} class={linkClass}>
                  {t(locale, label)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-line pt-4 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
      <p class="max-w-2xl text-xs">{t(locale, 'footer.disclaimer')}</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 lg:shrink-0">
        <ul class="flex flex-wrap gap-x-4" role="list" aria-label={t(locale, 'footer.legal')}>
          {legal.map(([label, path]) => (
            <li>
              <a href={localizePath(path, locale)} class={linkClass}>
                {t(locale, label)}
              </a>
            </li>
          ))}
        </ul>
        <span class="num">{t(locale, 'footer.copyright', { year })}</span>
      </div>
    </div>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  button?.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', dark ? '#12302a' : '#0f2a22');
    try {
      localStorage.setItem('dw.theme', dark ? 'dark' : 'light');
    } catch {
      // Storage blocked: the choice lasts for this page only.
    }
    sync();
  });
</script>
