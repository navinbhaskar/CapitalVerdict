---
import Logo from './Logo.astro';
import { t, type Locale } from '@/i18n/t';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-page flex flex-col gap-6 py-10 text-sm text-ink-muted sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-3">
      <Logo size={22} />
      <p class="max-w-md">{t(locale, 'footer.disclaimer')}</p>
    </div>
    <p class="num">{t(locale, 'footer.copyright', { year })}</p>
  </div>
</footer>
