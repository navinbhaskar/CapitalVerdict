---
/**
 * Inline SVG logo: a single-stroke lowercase "cv" with a brass dot. With `intro`, the mark draws
 * itself on the first page of a visit: the c and the v draw in, the dot drops onto the v, the
 * wordmark slides in (see .logo-intro in global.css; the classes keep their original names).
 * Paths use pathLength="1" so stroke drawing works at any size.
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
  intro?: boolean;
}
const { size = 28, withWordmark = true, intro = false } = Astro.props;
---

<span class="inline-flex items-center gap-2 text-ink" data-logo-intro={intro ? '' : undefined}>
  <svg
    class="logo-mark overflow-visible"
    width={size}
    height={size}
    viewBox="0 0 64 64"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="logo-stroke logo-bowl"
      pathLength="1"
      d="M30.5 29.5A12 12 0 1 0 30.5 46.5"
      fill="none"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
    ></path>
    <path
      class="logo-stroke logo-stem"
      pathLength="1"
      d="M36 28L44 50L52 28"
      fill="none"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <circle class="logo-dot fill-accent" cx="52" cy="16" r="5"></circle>
  </svg>
  {withWordmark && (
    <span
      translate="no"
      class="logo-word font-display text-lg font-semibold tracking-(--tracking-heading)"
    >
      CapitalVerdict
    </span>
  )}
</span>
