---
/**
 * The CapitalVerdict wordmark: "Capital" in ink, "Verdict" in brass, and a brass full stop.
 * With `intro`, the word slides in and the full stop drops into place on the first page of a
 * visit (see .logo-intro in global.css). The small "C." mark is for icons only (public/, brand/).
 */
interface Props {
  intro?: boolean;
}
const { intro = false } = Astro.props;
---

<span
  translate="no"
  class="inline-flex items-baseline font-display text-xl font-medium tracking-(--tracking-heading) text-ink"
  data-logo-intro={intro ? '' : undefined}
>
  <span class="logo-word">
    Capital<span class="text-accent-strong">Verdict</span>
  </span>
  <span class="logo-dot" aria-hidden="true"></span>
</span>
