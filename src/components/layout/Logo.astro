---
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 28, withWordmark = true } = Astro.props;
---

<span class="inline-flex items-center gap-2 text-ink">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <circle cx="29" cy="42" r="14" fill="none" stroke="currentColor" stroke-width="4.5"></circle>
    <line
      x1="43"
      y1="56"
      x2="43"
      y2="22"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
    ></line>
    <circle cx="43" cy="11" r="5" class="fill-accent"></circle>
  </svg>
  {withWordmark && <span class="text-[1.125rem] font-medium tracking-[0.01em]">decidewise</span>}
</span>
