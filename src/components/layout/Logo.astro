---
/**
 * Inline SVG logo. With `intro`, the mark draws itself on the first page of a visit: the bowl and
 * stem draw in, the dot drops onto the stem, the wordmark slides in (see .logo-intro in global.css).
 * Paths use pathLength="1" so stroke drawing works at any size.
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
  intro?: boolean;
}
const { size = 28, withWordmark = true, intro = false } = Astro.props;
---

<span class="inline-flex items-center gap-2 text-ink" data-logo-intro={intro ? '' : undefined}>
  <svg
    class="logo-mark overflow-visible"
    width={size}
    height={size}
    viewBox="0 0 64 64"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="logo-stroke logo-bowl"
      pathLength="1"
      d="M43 42a14 14 0 1 0-28 0a14 14 0 1 0 28 0"
      fill="none"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
    ></path>
    <path
      class="logo-stroke logo-stem"
      pathLength="1"
      d="M43 56V22"
      fill="none"
      stroke="currentColor"
      stroke-width="4.5"
      stroke-linecap="round"
    ></path>
    <circle class="logo-dot fill-accent" cx="43" cy="11" r="5"></circle>
  </svg>
  {withWordmark && (
    <span
      translate="no"
      class="logo-word font-display text-lg font-semibold tracking-(--tracking-heading)"
    >
      decidewise
    </span>
  )}
</span>
