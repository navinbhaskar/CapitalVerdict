{
  "name": "capitalverdict",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Big money decisions, honest maths, assumptions shown.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build",
    "build:prod": "node scripts/check-env.mjs && astro check && astro build && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "build:site": "node scripts/deploy.mjs --build-only",
    "deploy": "node scripts/deploy.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/preact": "^6.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
